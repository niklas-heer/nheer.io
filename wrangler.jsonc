// nheer.com on Cloudflare Workers (docs/cloudflare.md).
// Every page, image, script and feed in dist/ is a static asset: Cloudflare serves it without running worker/index.ts,
// so pages cost no Worker requests and keep working even if the free daily request allowance runs out. Only /api/*
// runs the Worker: the page-view counter, kept in the D1 database `nheer`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nheer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // nheer.com is a Worker Custom Domain (it owns the apex DNS record). www.nheer.com is a proxied placeholder record
  // that a zone redirect rule sends to the apex with 308, without running the Worker (docs/cloudflare.md).
  "routes": [{ "pattern": "nheer.com", "custom_domain": true }],
  // No second copy of the site on workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /about answers with a redirect to /about/, the address the site links to.
    "html_handling": "auto-trailing-slash",
    // An unknown address gets dist/404.html with status 404, without running the Worker.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // public/_headers and public/_redirects (copied into dist/) set the security and cache headers and the old addresses.
  "vars": { "SITE_ORIGIN": "https://nheer.com" },
  "d1_databases": [
    { "binding": "DB", "database_name": "nheer", "database_id": "13f4bee1-ca3d-47f0-8f20-19b1518268f8", "migrations_dir": "migrations" }
  ]
}
