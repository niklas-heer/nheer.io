---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Inky from "../components/Inky.astro";
import { ClientRouter } from "astro:transitions";
import { plainText } from "../utils/content-metadata";
import { siteConfig } from "../config";

interface Props {
    title: string;
    description?: string;
    lang?: "en" | "de";
    image?: string;
    /** Set on articles: shares as an article with its dates and tags. */
    article?: { published: Date; tags?: string[] };
}

const {
    title,
    description: rawDescription = "Homepage and blog by Niklas Heer",
    lang = "en",
    image = "/assets/images/nheer_logo.png",
    article,
} = Astro.props;
const fullTitle = title === "Home" ? "Niklas Heer" : `${plainText(title)} | Niklas Heer`;
const description = plainText(rawDescription);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const author = { "@type": "Person", name: siteConfig.author.name, url: Astro.site?.href };
const articleData = article && JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: plainText(title),
    description,
    datePublished: article.published.toISOString(),
    // Posts record no edit date, so the publication date is the latest known change.
    dateModified: article.published.toISOString(),
    author,
    publisher: author,
    image: ogImage.href,
    mainEntityOfPage: canonicalURL.href,
    inLanguage: lang,
    keywords: article.tags?.join(", ") || undefined,
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={lang} data-theme="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="author" content="Niklas Heer" />
        <meta name="generator" content={Astro.generator} />

        <!-- Canonical URL -->
        <link rel="canonical" href={canonicalURL} />

        <!-- Open Graph -->
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={article ? "article" : "website"} />
        <meta property="og:site_name" content="Niklas Heer" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={ogImage} />
        <meta
            property="og:locale"
            content={lang === "de" ? "de_DE" : "en_US"}
        />

        {article && <meta property="article:published_time" content={article.published.toISOString()} />}
        {article && <meta property="article:author" content={new URL("/about/", Astro.site)} />}
        {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
        {articleData && <script type="application/ld+json" set:html={articleData} />}

        <!-- Profiles that represent the author of this site -->
        <link rel="me" href={siteConfig.social.github} />
        <link rel="me" href={siteConfig.social.bluesky} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <link
            rel="icon"
            type="image/svg+xml"
            href="/assets/images/nheer_logo_new.svg"
        />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Niklas Heer's Blog"
            href="/rss.xml"
        />

        <title>{fullTitle}</title>

        <ClientRouter />

        <!-- Theme initialization (prevent flash): a saved choice wins, otherwise follow the system. -->
        <script is:inline>
            (() => {
                let theme = null;
                try {
                    theme = localStorage.getItem("theme");
                } catch {
                    // Without browser storage, the system preference decides.
                }
                if (theme !== "light" && theme !== "dark") {
                    theme = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
                }
                document.documentElement.dataset.theme = theme;
            })();
        </script>

        <!-- Navigation loading indicator script -->
        <script>
            let resetTimer: ReturnType<typeof setTimeout> | undefined;

            // Resolve the current bar each time: Astro replaces it on navigation.
            document.addEventListener("astro:before-preparation", () => {
                clearTimeout(resetTimer);
                const bar = document.getElementById("nav-loading-bar");
                bar?.classList.remove("complete");
                bar?.classList.add("loading");
            });
            document.addEventListener("astro:after-swap", () => {
                const bar = document.getElementById("nav-loading-bar");
                bar?.classList.remove("loading");
                bar?.classList.add("complete");
            });
            document.addEventListener("astro:page-load", () => {
                clearTimeout(resetTimer);
                resetTimer = setTimeout(() => {
                    document.getElementById("nav-loading-bar")?.classList.remove("loading", "complete");
                }, 300);
            });
        </script>
    </head>
    <body
        class="min-h-screen bg-background text-foreground transition-colors duration-300"
    >
        <!-- Navigation loading indicator -->
        <div class="nav-loading-bar" id="nav-loading-bar"></div>

        <!-- Skip to main content link for accessibility -->
        <a href="#main-content" class="skip-to-content">
            Skip to main content
        </a>
        <!-- One shell: header, footer and wide pages share its width. -->
        <div class="site-shell">
            <div class="site-header-slot">
                <Header />
            </div>
            <main id="main-content" class="site-main">
                <slot />
            </main>
            <Footer />
        </div>
        <!-- Inky the snarky octopus mascot (desktop only) -->
        <Inky />
    </body>
</html>
