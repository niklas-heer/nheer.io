---
import ArticleFigure from './ArticleFigure.astro';
interface Props {
  id: string;
  title: string;
  caption: string;
  label?: string;
  metrics: { label: string; value: string | number | null; unit?: string; detail?: string; change?: { text: string; tone?: 'positive' | 'negative' | 'neutral' } }[];
}
const { id, title, caption, label = 'In numbers', metrics } = Astro.props;
if (!metrics.length || metrics.some(item => typeof item.value === 'number' && !Number.isFinite(item.value))) {
  throw new Error(`${id}: metrics require at least one value; use null for an unknown measurement.`);
}
---
<ArticleFigure {id} {label} {title} {caption}>
  <dl class="metrics" style={`--columns: ${metrics.length === 4 ? 2 : Math.min(metrics.length, 3)}`}>
    {metrics.map(item => <div class="metric">
      <dt>{item.label}</dt>
      <dd class:list={['value', { unknown: item.value === null }]}>{item.value === null ? 'Not measured' : item.value}<span class="unit">{item.value !== null && item.unit}</span></dd>
      {item.change && <dd class:list={['change', item.change.tone ?? 'neutral']}>{item.change.text}</dd>}
      {item.detail && <dd class="detail">{item.detail}</dd>}
    </div>)}
  </dl>
</ArticleFigure>
<style>
  .metrics { display: grid; grid-template-columns: repeat(var(--columns), minmax(0, 1fr)); gap: .8rem; margin: 0; }
  .metric { min-width: 0; padding: 1.1rem; border: 1px solid #665075; border-top: 3px solid #c6adff; border-radius: 10px; background: #241c31; }
  dt { color: #d0c0df; font-size: .78rem; line-height: 1.6; }
  dd { margin: 0; }
  .value { color: #f0eafa; font: 650 clamp(1.8rem, 5vw, 2.6rem)/1.25 system-ui, sans-serif; font-variant-numeric: tabular-nums; letter-spacing: -.04em; margin: .6rem 0; overflow-wrap: anywhere; }
  .unit { color: #c6adff; font-size: .85rem; letter-spacing: 0; margin-left: .35rem; }
  .unknown { color: #bdb1ca; font-size: 1.25rem; letter-spacing: 0; }
  .change { display: inline-block; font: 600 .7rem/1.5 system-ui, sans-serif; padding: .25rem .5rem; border-radius: 5px; background: #332740; color: #d6c5ed; margin: 0 0 .5rem; }
  .positive { background: #203b36; color: #8ae0c6; }
  .negative { background: #412733; color: #ffb1bd; }
  .detail { color: #c4b8d3; font-size: .75rem; line-height: 1.7; }
  @media (max-width: 560px) { .metrics { grid-template-columns: 1fr; } }
</style>
