---
// Inky - The snarky tech octopus mascot.
// He is a still picture first. The animation (lottie-web and its JSON, about
// half a megabyte together) is fetched only once the browser is idle or the
// visitor reaches for him, and never when reduced motion is requested.
import { getInkyComments } from "../utils/inky";
import { INKY_HIDDEN_KEY } from "../utils/inky-client";

const comments = await getInkyComments();
---

<div class="inky-container" id="inky-container">
    <!-- Speech bubble (hidden by default) -->
    <div class="inky-bubble" id="inky-bubble" role="status" aria-live="polite">
        <p class="inky-text" id="inky-text"></p>
        <div class="inky-footer">
            <span class="inky-name">- Inky</span>
            <a
                class="inky-source"
                id="inky-source"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                title=""
            >
                <!-- Hacker News icon -->
                <svg
                    class="source-icon hn-icon"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                >
                    <path
                        d="M0 0v24h24V0H0zm12.3 12.5l3.6-6.5h1.7l-4.5 8v5.5h-1.6V14l-4.5-8h1.8l3.5 6.5z"
                    ></path>
                </svg>
                <!-- The New Stack icon (generic news/article icon) -->
                <svg
                    class="source-icon tns-icon"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                >
                    <path
                        d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"
                    ></path>
                </svg>
                <!-- DevOps.com icon (gear/cog icon) -->
                <svg
                    class="source-icon devops-icon"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                >
                    <path
                        d="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                    ></path>
                </svg>
            </a>
        </div>
    </div>

    <!-- Inky the Octopus: a still poster, replaced by the animation when it arrives -->
    <button
        type="button"
        class="inky-mascot"
        id="inky-mascot"
        aria-label="Ask Inky for a snarky tech comment"
        aria-expanded="false"
        aria-controls="inky-bubble"
        title="Click me!"
    >
        <span class="inky-frame">
            <img
                class="inky-poster"
                src="/assets/articles/2026/inky-poster.svg"
                alt=""
                width="200"
                height="200"
                loading="lazy"
                decoding="async"
            />
            <span id="inky-lottie" class="inky-lottie" aria-hidden="true"></span>
        </span>
    </button>

    <button type="button" class="inky-hide" id="inky-hide" aria-label="Hide Inky" title="Hide Inky">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
    </button>
</div>

<!-- Stays behind when Inky is hidden, so he can be called back. -->
<button type="button" class="inky-show" id="inky-show" aria-label="Show Inky">
    <span aria-hidden="true">❯</span> inky
</button>

<!-- Apply a remembered "hidden" before the first paint, so he never flashes. -->
<script is:inline data-astro-rerun define:vars={{ INKY_HIDDEN_KEY }}>
    try {
        if (localStorage.getItem(INKY_HIDDEN_KEY) === "true") {
            document.getElementById("inky-container").dataset.hidden = "true";
        }
    } catch {
        // Without storage Inky simply starts out visible.
    }
</script>

<!-- Pass comments to JS -->
<script define:vars={{ comments }}>
    window.inkyComments = comments;
</script>

<script>
    import {
        createInkyDeck,
        readInkyHidden,
        writeInkyHidden,
        type InkyDeck,
        type InkyLine,
        type InkyTurn,
    } from "../utils/inky-client";

    const ANIMATION = "inky-animation";
    const DEACTIVATE_DELAY = 12000; // 12 seconds
    const IDLE_TIMEOUT = 4000;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    // lottie-web is imported on demand only; see scheduleAnimation().
    let lottieModule: typeof import("lottie-web") | null = null;
    async function loadLottie() {
        if (!lottieModule) {
            lottieModule = await import("lottie-web");
        }
        return lottieModule.default;
    }

    reducedMotion.addEventListener("change", () => {
        if (reducedMotion.matches) {
            lottieModule?.default.pause(ANIMATION);
        } else if (lottieModule) {
            lottieModule.default.play(ANIMATION);
        } else {
            current?.animate();
        }
    });

    // What the page's Inky needs from the document-level listeners below.
    interface InkySession {
        container: HTMLElement;
        closeBubble: () => void;
        isBubbleOpen: () => boolean;
        animate: () => void;
        stop: () => void;
    }
    let current: InkySession | null = null;

    // One bubble at a time: an outside click or Escape closes it.
    document.addEventListener("click", (event) => {
        if (current && !current.container.contains(event.target as Node)) current.closeBubble();
    });
    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && current?.isBubbleOpen()) current.closeBubble();
    });

    // Astro swaps the document on client navigation; drop the old Inky first and
    // carry a "hidden" choice over, so it also holds where storage is blocked.
    document.addEventListener("astro:before-swap", (event) => {
        const hidden = document.getElementById("inky-container")?.dataset.hidden;
        const next = event.newDocument.getElementById("inky-container");
        if (hidden && next) next.dataset.hidden = hidden;
        current?.stop();
        current = null;
    });

    interface Heckle { section: string; comment: string }

    /**
     * On a post with pre-generated heckles, Inky follows the cursor along the
     * left edge and, the first time the cursor rests on a section, surfaces
     * beside it with that section's line. Once per section per page view.
     */
    function startRoaming(
        container: HTMLElement,
        article: HTMLElement,
        heckles: Heckle[],
        speak: (comment: string) => void,
        signal: AbortSignal,
    ) {
        const MASCOT = 200;
        const MARGIN = 12;
        const follow = !reducedMotion.matches;
        const spoken = new Set<string>();
        let clientY = window.innerHeight - MASCOT / 2;
        let pending = false;

        if (follow) container.classList.add("inky-roaming");
        signal.addEventListener("abort", () => container.classList.remove("inky-roaming", "inky-bubble-below"));

        function ranges() {
            const tops = heckles
                .map((h) => ({ h, el: h.section === "intro" ? article : document.getElementById(h.section) }))
                .filter((m): m is { h: Heckle; el: HTMLElement } => Boolean(m.el))
                .map((m) => ({ h: m.h, top: m.el.getBoundingClientRect().top + window.scrollY }))
                .sort((a, b) => a.top - b.top);
            const end = article.getBoundingClientRect().bottom + window.scrollY;
            return tops.map((t, i) => ({ h: t.h, top: t.top, bottom: tops[i + 1]?.top ?? end }));
        }

        function place() {
            if (!follow) return;
            const top = Math.max(MARGIN, Math.min(window.innerHeight - MASCOT - MARGIN, clientY - MASCOT / 2));
            container.style.setProperty("--inky-top", `${top}px`);
            container.classList.toggle("inky-bubble-below", top < 260);
        }

        function heckle() {
            const pageY = clientY + window.scrollY;
            const hit = ranges().find((r) => pageY >= r.top && pageY < r.bottom);
            if (!hit || spoken.has(hit.h.section)) return;
            spoken.add(hit.h.section);
            speak(hit.h.comment);
        }

        function update() {
            if (pending || signal.aborted) return;
            pending = true;
            requestAnimationFrame(() => {
                pending = false;
                if (signal.aborted) return;
                try {
                    place();
                    heckle();
                } catch (error) {
                    console.error("Inky could not place a heckle", error);
                }
            });
        }

        document.addEventListener("mousemove", (event) => { clientY = event.clientY; update(); }, { signal });
        document.addEventListener("scroll", update, { passive: true, signal });
        place();
    }

    /** Wake Inky on this page: comments, heckles and, later, the animation. */
    function startSession(
        container: HTMLElement,
        mascot: HTMLElement,
        lottieContainer: HTMLElement,
        bubble: HTMLElement,
        text: HTMLElement,
        sourceLink: HTMLAnchorElement | null,
    ): InkySession {
        const controller = new AbortController();
        const { signal } = controller;
        const comments = ((window as any).inkyComments ?? []) as InkyLine[];
        const deck: InkyDeck = createInkyDeck(comments);
        let isActivated = false;
        let deactivateTimer: ReturnType<typeof setTimeout> | null = null;
        let animationRequested = false;

        function setBubble(open: boolean) {
            bubble.classList.toggle("visible", open);
            mascot.setAttribute("aria-expanded", String(open));
        }

        function resetDeactivateTimer() {
            if (deactivateTimer) clearTimeout(deactivateTimer);
            deactivateTimer = setTimeout(() => {
                if (isActivated) {
                    isActivated = false;
                    mascot.classList.remove("activated");
                    setBubble(false);
                }
            }, DEACTIVATE_DELAY);
        }

        function updateSourceIcon(turn: InkyTurn) {
            if (!sourceLink) return;
            for (const icon of sourceLink.querySelectorAll(".source-icon")) {
                icon.classList.remove("visible");
            }
            if (!turn.source) {
                sourceLink.style.display = "none";
                return;
            }
            sourceLink.href = turn.source.url;
            sourceLink.title = turn.source.title;
            sourceLink.setAttribute("aria-label", `Source: ${turn.source.title}`);
            sourceLink.style.display = "flex";
            const icon = { hackernews: ".hn-icon", thenewstack: ".tns-icon", devops: ".devops-icon" }[turn.source.type];
            if (icon) sourceLink.querySelector(icon)?.classList.add("visible");
        }

        function say(turn: InkyTurn) {
            isActivated = true;
            mascot.classList.add("activated");
            // Open first: the bubble is a live region and must be shown to announce.
            setBubble(true);
            text.textContent = turn.text;
            updateSourceIcon(turn);
            resetDeactivateTimer();
        }

        // The animation replaces the poster once it has drawn its first frame.
        async function animate() {
            if (animationRequested || signal.aborted || reducedMotion.matches) return;
            animationRequested = true;
            try {
                const lottie = await loadLottie();
                if (signal.aborted || !lottieContainer.isConnected) return;
                lottie.destroy(ANIMATION);
                const animation = lottie.loadAnimation({
                    container: lottieContainer,
                    renderer: "svg",
                    loop: true,
                    autoplay: !reducedMotion.matches,
                    path: "/animations/octopus.json",
                    name: ANIMATION,
                });
                animation.addEventListener("DOMLoaded", () => {
                    if (!signal.aborted) container.classList.add("inky-animated");
                });
            } catch (error) {
                // The poster stays; Inky still talks.
                animationRequested = false;
                console.error("Inky's animation could not be loaded", error);
            }
        }

        // Not during page load: wait until the page has loaded and the browser is
        // idle. A visitor who asks for less data keeps the still picture until
        // they reach for him.
        function scheduleAnimation() {
            if (reducedMotion.matches) return;
            if ((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData) return;
            const whenIdle = () => {
                if (signal.aborted) return;
                if ("requestIdleCallback" in window) {
                    requestIdleCallback(() => animate(), { timeout: IDLE_TIMEOUT });
                } else {
                    setTimeout(animate, 1500);
                }
            };
            if (document.readyState === "complete") whenIdle();
            else window.addEventListener("load", whenIdle, { once: true, signal });
        }

        mascot.addEventListener("click", (event) => {
            event.stopPropagation();
            animate();
            say(deck.next());
        }, { signal });
        mascot.addEventListener("pointerenter", () => {
            animate();
            if (isActivated) resetDeactivateTimer();
        }, { signal });
        mascot.addEventListener("focus", () => animate(), { signal });

        // Posts may carry pre-generated heckles in their frontmatter.
        const heckleNode = document.getElementById("inky-heckles");
        const article = document.querySelector<HTMLElement>("article");
        let heckles: Heckle[] = [];
        try {
            heckles = heckleNode ? JSON.parse(heckleNode.textContent ?? "[]") : [];
        } catch {
            heckles = [];
        }
        if (heckles.length > 0 && article) {
            startRoaming(container, article, heckles, (comment) => {
                say({ text: comment, source: null, shown: deck.shown, total: deck.total, exhausted: false });
            }, signal);
        }

        scheduleAnimation();

        return {
            container,
            closeBubble: () => setBubble(false),
            isBubbleOpen: () => bubble.classList.contains("visible"),
            animate,
            stop() {
                controller.abort();
                if (deactivateTimer) clearTimeout(deactivateTimer);
                lottieModule?.default.destroy(ANIMATION);
                container.classList.remove("inky-animated");
                mascot.classList.remove("activated");
                setBubble(false);
            },
        };
    }

    function initInky() {
        const container = document.getElementById("inky-container");
        const mascot = document.getElementById("inky-mascot");
        const lottieContainer = document.getElementById("inky-lottie");
        const bubble = document.getElementById("inky-bubble");
        const text = document.getElementById("inky-text");
        const hide = document.getElementById("inky-hide");
        const show = document.getElementById("inky-show");
        const sourceLink = document.getElementById("inky-source") as HTMLAnchorElement | null;

        if (!container || !mascot || !bubble || !text || !lottieContainer || !hide || !show) return;
        // Both the initial script run and astro:page-load reach here on the first
        // page view. The flag lives on the element, so a freshly swapped page
        // initializes again while the same page never initializes twice.
        if (mascot.dataset.inkyReady) return;
        mascot.dataset.inkyReady = "true";

        const start = () => {
            // Phones and narrow windows never see him, so nothing is loaded for them.
            if (window.innerWidth < 1200 || container.dataset.hidden) return;
            current = startSession(container, mascot, lottieContainer, bubble, text, sourceLink);
        };

        hide.addEventListener("click", (event) => {
            event.stopPropagation();
            current?.stop();
            current = null;
            container.dataset.hidden = "true";
            writeInkyHidden(true);
            show.focus();
        });
        show.addEventListener("click", () => {
            delete container.dataset.hidden;
            writeInkyHidden(false);
            start();
            mascot.focus();
        });

        if (readInkyHidden()) container.dataset.hidden = "true";
        start();
    }

    // Initialize on first load and after View Transitions navigation
    initInky();
    document.addEventListener("astro:page-load", initInky);
</script>

<style>
    .inky-container {
        position: fixed;
        bottom: 0;
        left: 0;
        z-index: 100;
        display: none;
    }

    /* Hidden by choice: only the small "show" tab remains. */
    .inky-show {
        display: none;
    }

    @media (min-width: 1200px) {
        .inky-container {
            display: block;
        }

        .inky-container[data-hidden] {
            display: none;
        }

        .inky-container[data-hidden] + .inky-show {
            display: inline-flex;
        }
    }

    .inky-show {
        position: fixed;
        left: 0.75rem;
        bottom: 0.75rem;
        z-index: 100;
        align-items: center;
        gap: 0.4em;
        padding: 0.25rem 0.625rem;
        font-family: var(--font-mono);
        font-size: var(--text-label);
        color: var(--color-muted);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-chip);
        cursor: pointer;
        transition:
            color 0.15s ease,
            border-color 0.15s ease;
    }

    .inky-show span {
        color: var(--color-accent);
    }

    .inky-show:hover {
        color: var(--color-foreground);
        border-color: var(--color-accent);
    }

    /* On heckled posts the container follows the cursor along the left edge. */
    .inky-container.inky-roaming {
        bottom: auto;
        top: var(--inky-top, calc(100vh - 200px));
        transition: top 0.45s ease-out;
    }

    .inky-container.inky-bubble-below .inky-bubble {
        bottom: auto;
        top: 180px;
    }

    .inky-container.inky-bubble-below .inky-bubble::after {
        bottom: auto;
        top: -10px;
        border-width: 0 10px 10px;
        border-color: transparent transparent var(--color-surface);
    }

    .inky-container.inky-bubble-below .inky-bubble::before {
        bottom: auto;
        top: -14px;
        border-width: 0 12px 12px;
        border-color: transparent transparent var(--color-accent);
    }

    @media (prefers-reduced-motion: reduce) {
        .inky-container.inky-roaming {
            transition: none;
        }
    }

    .inky-mascot {
        display: block;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        width: 200px;
        height: 200px;
        opacity: 0.6;
        transition:
            opacity 0.5s ease,
            transform 0.9s cubic-bezier(0.34, 1.56, 0.64, 1);
        /* Peek from left side, rotated so head/eyes show */
        transform: translateX(-90px) rotate(25deg);
        transform-origin: center center;
    }

    .inky-mascot:hover,
    .inky-mascot:focus-visible,
    .inky-mascot.activated {
        opacity: 1;
        /* Slide out and rotate to normal */
        transform: translateX(10px) rotate(0deg);
    }

    /* He stays out while the pointer or focus is on his hide control. */
    .inky-container:has(.inky-hide:hover, .inky-hide:focus-visible) .inky-mascot {
        opacity: 1;
        transform: translateX(10px) rotate(0deg);
    }

    .inky-mascot:active {
        transform: translateX(10px) rotate(0deg) scale(0.97);
    }

    .inky-mascot:focus-visible {
        border-radius: var(--radius-panel);
    }

    /* The poster and the animation share one box, so the swap does not move him. */
    .inky-frame {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        filter: drop-shadow(0 0 8px color-mix(in srgb, var(--color-accent) 30%, transparent));
    }

    .inky-mascot:hover .inky-frame,
    .inky-mascot.activated .inky-frame {
        filter: drop-shadow(0 0 15px color-mix(in srgb, var(--color-accent) 50%, transparent));
    }

    .inky-poster,
    .inky-lottie {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
    }

    .inky-poster {
        object-fit: contain;
    }

    .inky-lottie {
        visibility: hidden;
    }

    .inky-container.inky-animated .inky-poster {
        visibility: hidden;
    }

    .inky-container.inky-animated .inky-lottie {
        visibility: visible;
    }

    /* Hide control: appears when he is hovered, focused or talking. */
    .inky-hide {
        position: absolute;
        left: 0.5rem;
        bottom: 0.5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.75rem;
        height: 1.75rem;
        padding: 0;
        color: var(--color-muted);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 50%;
        cursor: pointer;
        opacity: 0;
        transition:
            opacity 0.2s ease,
            color 0.15s ease,
            border-color 0.15s ease;
    }

    .inky-container:hover .inky-hide,
    .inky-container:focus-within .inky-hide,
    .inky-mascot.activated ~ .inky-hide {
        opacity: 1;
    }

    .inky-hide:hover {
        color: var(--color-foreground);
        border-color: var(--color-accent);
    }

    /* Speech bubble */
    .inky-bubble {
        position: absolute;
        bottom: 180px;
        left: 80px;
        background: var(--color-surface);
        border: 2px solid var(--color-accent);
        border-radius: var(--radius-panel);
        padding: 1rem;
        max-width: 280px;
        min-width: 200px;
        box-shadow:
            0 0 20px color-mix(in srgb, var(--color-accent) 20%, transparent),
            0 4px 20px rgb(0 0 0 / 0.15);
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px) scale(0.95);
        transition: all 0.2s ease;
    }

    .inky-bubble.visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
    }

    /* Bubble arrow */
    .inky-bubble::after {
        content: "";
        position: absolute;
        bottom: -10px;
        left: 40px;
        border-width: 10px 10px 0;
        border-style: solid;
        border-color: var(--color-surface) transparent transparent;
    }

    .inky-bubble::before {
        content: "";
        position: absolute;
        bottom: -14px;
        left: 38px;
        border-width: 12px 12px 0;
        border-style: solid;
        border-color: var(--color-accent) transparent transparent;
    }

    .inky-text {
        margin: 0;
        font-size: var(--text-small);
        line-height: 1.5;
        color: var(--color-foreground);
    }

    .inky-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 0.5rem;
    }

    .inky-name {
        font-size: var(--text-label);
        color: var(--color-accent);
        font-style: italic;
    }

    .inky-source {
        display: none;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        color: var(--color-foreground);
        opacity: 0.6;
        transition:
            opacity 0.2s ease,
            color 0.2s ease;
    }

    .inky-source:hover {
        opacity: 1;
        color: var(--color-accent);
    }

    .source-icon {
        display: none;
        width: 16px;
        height: 16px;
    }

    .source-icon.visible {
        display: block;
    }
</style>
