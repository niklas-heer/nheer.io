---
import { fetchPageViews } from '../utils/page-views';
const enabled = import.meta.env.PUBLIC_PAGE_VIEWS_ENABLED === 'true';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const publicPage = !path.startsWith('/drafts') && !['/404', '/404.html'].includes(path);
const snapshot = enabled && publicPage ? await fetchPageViews() : null;
const views = snapshot?.totals.get(path) ?? 0;
---

{enabled && publicPage && snapshot && (
  <p class="mt-2" data-page-views data-path={path} data-host={Astro.site?.hostname} title="Recorded since September 19, 2026; refreshed every three hours.">
    {new Intl.NumberFormat('en-US').format(views)} {views === 1 ? 'view' : 'views'} on this page
  </p>
)}

<script>
  import { inject, pageview } from '@vercel/analytics';

  document.addEventListener('astro:page-load', () => {
    const counter = document.querySelector<HTMLElement>('[data-page-views]');
    if (!counter) return;
    const path = counter.dataset.path!;

    // Only canonical production traffic contributes to the public count.
    if (location.hostname === counter.dataset.host) {
      inject({
        mode: 'production', framework: 'astro', disableAutoTrack: true,
        beforeSend(event) {
          const url = new URL(event.url);
          url.search = '';
          url.hash = '';
          return { ...event, url: url.href };
        },
      });
      pageview({ path, route: path });
    }

  });
</script>
