---
import { getImage } from 'astro:assets';
import { optimizeContentImages } from '../utils/optimize-content';

interface Props {
  class?: string;
}

const { class: className = 'prose' } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpeg,jpg,png,webp}'
);

// Resolve only images used by this article, before HTML reaches the browser.
const content = await optimizeContentImages(await Astro.slots.render('default'), async (src) => {
  const load = images[src.replace('/assets/images/', '/src/assets/images/')];
  if (!load) return null;
  const { default: image } = await load();
  const widths = [...new Set([400, 800, 1200].map((width) => Math.min(width, image.width)))];
  const variants = await Promise.all(widths.map((width) => getImage({
    src: image, width, format: 'webp', quality: 80,
  })));
  const primary = variants[Math.min(1, variants.length - 1)];
  return {
    src: primary.src,
    srcset: variants.map((variant, index) => `${variant.src} ${widths[index]}w`).join(', '),
    width: String(image.width),
    height: String(image.height),
  };
});
---

<div class={className} set:html={content} />
