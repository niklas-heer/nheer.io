---
import ArticleFigure from './ArticleFigure.astro';

interface Props { id: string }
const { id } = Astro.props;

const notes = [
  { mark: '1', code: '.expect("file not found")', text: 'Opening a file can fail. Rust makes that possibility part of the value, so the program has to say what happens when it does.' },
  { mark: '2', code: '.parse::<i32>().unwrap()', text: 'Text becomes a number only once you name which number type you want, and only if you also handle the case where the text is not one.' },
  { mark: '3', code: 'let mut x: f64 = 1.0;', text: 'Precision is a decision. The comment above it was added seven minutes after the first commit, once the result came out wrong.' },
  { mark: '4', code: 'i as f64', text: 'An integer does not quietly become a floating-point number. The cast has to be written down.' },
];
---
<ArticleFigure
  id={id}
  label="February 2018 / the same calculation twice"
  title="Sixteen lines of Python. Twenty-four lines of Rust."
  caption="Both files as committed on 17 February 2018 (Python 20:05:16, Rust 20:05:33), shebang and encoding lines omitted from the Python file. The marked lines are the ones the Rust compiler would not let the program leave out."
>
  <div class="first-contact">
    <div class="pane">
      <p class="pane-title"><span>leibniz.py</span>Python 3.6</p>
      <pre tabindex="0"><code>with open("rounds.txt") as file:
    rounds = int(file.read())

x = 1
pi = 1

for i in range(2, rounds + 2):
    x *= -1
    pi += x / (2 * i - 1)

pi *= 4

print("π = " + str(pi))</code></pre>
    </div>
    <div class="pane">
      <p class="pane-title"><span>leibniz.rs</span>Rust 1.22</p>
      <pre tabindex="0"><code>use std::fs::File;
use std::io::prelude::*;

fn main() &#123;
    <mark data-mark="1">let mut file = File::open("./rounds.txt").expect("file not found");</mark>

    let mut contents = String::new();
    <mark data-mark="1">file.read_to_string(&amp;mut contents)
        .expect("something went wrong reading the file");</mark>

    <mark data-mark="2">let rounds = &amp;contents.trim().parse::&lt;i32&gt;().unwrap();</mark>

    // We need to use f64 instead of f32 because otherwise the precision would be off
    <mark data-mark="3">let mut x: f64 = 1.0;
    let mut pi: f64 = 1.0;</mark>

    for i in 2..(rounds + 2) &#123;
        x *= -1.0;
        pi = pi + (x / (2.0 * <mark data-mark="4">i as f64</mark> - 1.0));
    &#125;

    pi = pi * 4.0;

    println!("π = &#123;&#125;", pi);
&#125;</code></pre>
    </div>
  </div>
  <ol class="notes" aria-label="What the marked Rust lines do">
    {notes.map((note) => (
      <li>
        <span class="mark-badge" aria-hidden="true">{note.mark}</span>
        <div><code>{note.code}</code><p>{note.text}</p></div>
      </li>
    ))}
  </ol>
</ArticleFigure>
<style>
  .first-contact { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr); gap: 1rem; }
  .pane { min-width: 0; border: 1px solid #47394f; border-radius: 12px; background: #120f1a; overflow: hidden; }
  .pane-title { display: flex; justify-content: space-between; gap: .75rem; margin: 0; padding: .55rem .85rem; border-bottom: 1px solid #47394f; color: #c4b8d3; font: .7rem/1.5 ui-monospace, monospace; }
  .pane-title span { color: #f0eafa; font-weight: 650; }
  pre { margin: 0; padding: .9rem .85rem; overflow-x: auto; font: .72rem/1.55 ui-monospace, monospace; color: #e8e2f2; tab-size: 4; white-space: pre-wrap; overflow-wrap: anywhere; }
  pre:focus-visible { outline: 3px solid #8ae0c6; outline-offset: -3px; }
  code { font: inherit; }
  mark { position: relative; display: inline; box-decoration-break: clone; -webkit-box-decoration-break: clone; padding: .05rem .2rem; margin: 0 -.2rem; border-radius: 4px; background: rgba(240, 205, 142, .18); color: #fbe9c4; box-shadow: inset 2px 0 0 #f0cd8e; }
  mark::after { content: attr(data-mark); display: inline-grid; place-items: center; margin-left: .45rem; width: 1.05rem; height: 1.05rem; border-radius: 999px; background: #f0cd8e; color: #241c10; font: 700 .6rem/1 ui-monospace, monospace; vertical-align: .1em; }
  .notes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem 1.2rem; margin: 1.2rem 0 0; padding: 0; list-style: none; }
  .notes li { display: flex; gap: .65rem; align-items: flex-start; min-width: 0; }
  .mark-badge { flex: 0 0 1.4rem; display: grid; place-items: center; height: 1.4rem; border-radius: 999px; background: #f0cd8e; color: #241c10; font: 700 .7rem/1 ui-monospace, monospace; margin-top: .1rem; }
  .notes code { display: block; color: #fbe9c4; font: .72rem/1.5 ui-monospace, monospace; overflow-wrap: anywhere; }
  .notes p { margin: .2rem 0 0; color: #d5cce6; font-size: .8rem; line-height: 1.55; }
  @media (max-width: 720px) {
    .first-contact { grid-template-columns: minmax(0, 1fr); }
    .notes { grid-template-columns: minmax(0, 1fr); }
  }
</style>
