---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
    { name: "Blog", href: "/posts", icon: "blog" },
    { name: "Reading", href: "/reading", icon: "reading" },
    { name: "Listening", href: "/listening", icon: "podcasts" },
    { name: "Projects", href: "/projects", icon: "projects" },
    { name: "Reviews", href: "/reviews", icon: "reviews" },
    { name: "About", href: "/about", icon: "about" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
    currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header">
    <a href="/" class="wordmark group" aria-label="nheer, home">
        <span class="terminal-text" style="view-transition-name: site-title;">
            <span class="terminal-prompt">❯</span>
            <span class="terminal-typed" data-text="nheer"></span>
            <span class="terminal-cursor">_</span>
        </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="site-nav nav-menu-container" aria-label="Main">
        <ul class="site-nav-list">
            {
                navItems.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            class="site-nav-link"
                            aria-current={isActive(link.href) ? "page" : undefined}
                        >
                            {link.name}
                        </a>
                    </li>
                ))
            }
        </ul>
        <div class="site-nav-toggle">
            <ThemeToggle />
        </div>
    </nav>

    <!-- Mobile Navigation -->
    <div class="mobile-controls">
        <ThemeToggle />
        <button
            id="mobile-menu-button"
            class="mobile-menu-button"
            aria-label="Toggle menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
            <svg
                class="hamburger-icon w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg
                class="close-icon w-6 h-6 hidden"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>
</header>

<!-- Mobile Menu Overlay -->
<nav id="mobile-menu" class="mobile-menu" aria-label="Main, mobile">
    <ul class="mobile-menu-list">
        {
            navItems.map((link) => (
                <li>
                    <a
                        href={link.href}
                        class="mobile-nav-link"
                        aria-current={isActive(link.href) ? "page" : undefined}
                    >
                        <span class="nav-icon" data-icon={link.icon} />
                        <span>{link.name}</span>
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<!-- SVG Icon Templates (hidden, used by JS) -->
<template id="icon-blog">
    <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
        ></path>
        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
        ></path>
    </svg>
</template>

<template id="icon-reading">
    <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
        ></path>
    </svg>
</template>

<template id="icon-podcasts">
    <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
        <path
            d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"
        ></path>
    </svg>
</template>

<template id="icon-projects">
    <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <polyline points="16 18 22 12 16 6"></polyline>
        <polyline points="8 6 2 12 8 18"></polyline>
    </svg>
</template>

<template id="icon-reviews">
    <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <polygon
            points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
        ></polygon>
    </svg>
</template>

<template id="icon-about">
    <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
    </svg>
</template>

<style>
    .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        min-height: 2.75rem;
    }

    .wordmark {
        color: var(--color-foreground);
        font-size: 1.25rem;
        font-weight: 600;
    }

    .wordmark:hover {
        color: var(--color-foreground);
    }

    .terminal-text {
        font-family: var(--font-mono);
        display: inline-flex;
        align-items: center;
        gap: 0.3em;
        letter-spacing: -0.02em;
    }

    .terminal-prompt {
        color: var(--color-accent);
        font-weight: 500;
    }

    .terminal-typed {
        position: relative;
        min-width: 5ch;
    }

    .terminal-cursor {
        color: var(--color-accent);
        animation: blink 1s step-end infinite;
        font-weight: 500;
    }

    @keyframes blink {
        0%,
        50% {
            opacity: 1;
        }
        51%,
        100% {
            opacity: 0;
        }
    }

    .group:hover .terminal-cursor {
        animation: blink 0.5s step-end infinite;
    }

    /* Desktop navigation */
    .site-nav {
        display: none;
        align-items: center;
        gap: 0.75rem;
    }

    .site-nav-list {
        display: flex;
        align-items: center;
        gap: 0.125rem;
    }

    .site-nav-link {
        display: inline-block;
        padding: 0.375rem 0.625rem;
        border-radius: var(--radius-chip);
        font-size: 0.9375rem;
        font-weight: 500;
        color: var(--color-muted);
        transition:
            color 0.15s ease,
            background-color 0.15s ease;
    }

    .site-nav-link:hover {
        color: var(--color-foreground);
        background: var(--color-surface-raised);
    }

    .site-nav-link[aria-current="page"] {
        color: var(--color-foreground);
        font-weight: 600;
    }

    .site-nav-link[aria-current="page"]::before {
        content: "❯ ";
        font-family: var(--font-mono);
        color: var(--color-accent);
    }

    .site-nav-toggle {
        display: flex;
        align-items: center;
        padding-left: 0.75rem;
        border-left: 1px solid var(--color-border);
    }

    /* Mobile controls */
    .mobile-controls {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .mobile-menu-button {
        padding: 0.5rem;
        border-radius: var(--radius-chip);
        color: var(--color-muted);
        transition: color 0.15s ease;
    }

    .mobile-menu-button:hover {
        color: var(--color-foreground);
    }

    .mobile-menu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 50;
        margin-top: 0.75rem;
    }

    .mobile-menu.open {
        display: block;
    }

    .mobile-menu-list {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        padding: 0.5rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
    }

    .mobile-nav-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.625rem 0.75rem;
        border-radius: var(--radius-chip);
        color: var(--color-muted);
        font-weight: 500;
        transition:
            color 0.15s ease,
            background-color 0.15s ease;
    }

    .mobile-nav-link:hover,
    .mobile-nav-link[aria-current="page"] {
        color: var(--color-foreground);
        background: var(--color-surface-raised);
    }

    .mobile-nav-link .nav-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        color: var(--color-muted);
    }

    .mobile-nav-link:hover .nav-icon,
    .mobile-nav-link[aria-current="page"] .nav-icon {
        color: var(--color-accent);
    }

    @media (min-width: 40rem) {
        .site-nav {
            display: flex;
        }

        .mobile-controls,
        .mobile-menu {
            display: none;
        }
    }
</style>

<script>
    function initTerminalTyping() {
        const typedElements = document.querySelectorAll(".terminal-typed");

        typedElements.forEach((el) => {
            const text = el.getAttribute("data-text") || "";
            const htmlEl = el as HTMLElement;

            // Check if already typed (for view transitions)
            if (htmlEl.textContent === text) return;

            htmlEl.textContent = "";
            let i = 0;

            function type() {
                if (i < text.length) {
                    htmlEl.textContent += text.charAt(i);
                    i++;
                    setTimeout(type, 100 + Math.random() * 50);
                }
            }

            // Small delay before starting
            setTimeout(type, 300);
        });
    }

    // Run on initial load
    initTerminalTyping();

    // Run after view transitions
    document.addEventListener("astro:after-swap", initTerminalTyping);

    // Mobile menu toggle
    function initMobileMenu() {
        const menuButton = document.getElementById("mobile-menu-button");
        const mobileMenu = document.getElementById("mobile-menu");
        const hamburgerIcon = menuButton?.querySelector(".hamburger-icon");
        const closeIcon = menuButton?.querySelector(".close-icon");

        if (!menuButton || !mobileMenu || !hamburgerIcon || !closeIcon) return;

        menuButton.addEventListener("click", () => {
            const isOpen = mobileMenu.classList.toggle("open");
            menuButton.setAttribute("aria-expanded", String(isOpen));
            hamburgerIcon.classList.toggle("hidden", isOpen);
            closeIcon.classList.toggle("hidden", !isOpen);
        });

        // Close menu when clicking a link
        mobileMenu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => {
                mobileMenu.classList.remove("open");
                menuButton.setAttribute("aria-expanded", "false");
                hamburgerIcon.classList.remove("hidden");
                closeIcon.classList.add("hidden");
            });
        });
    }

    initMobileMenu();
    document.addEventListener("astro:after-swap", initMobileMenu);

    // Inject SVG icons into nav items
    function initNavIcons() {
        const navIcons = document.querySelectorAll(".nav-icon");

        navIcons.forEach((iconContainer) => {
            const iconName = iconContainer.getAttribute("data-icon");
            if (!iconName) return;

            const template = document.getElementById(
                `icon-${iconName}`,
            ) as HTMLTemplateElement;
            if (!template) return;

            // Clear and inject icon
            iconContainer.innerHTML = "";
            iconContainer.appendChild(template.content.cloneNode(true));
        });
    }

    initNavIcons();
    document.addEventListener("astro:after-swap", initNavIcons);
</script>
