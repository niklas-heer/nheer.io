---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { parseEmoji } from "../utils/emoji";
import { siteConfig } from "../config";
import { getPostPath } from "../utils/content-metadata";
import { fetchReadingData } from "../utils/hardcover";
import { fetchPodcastData } from "../utils/database";
import { fetchGitHubData, getLanguageColor } from "../utils/github";

// Get latest posts
const allPosts = await getCollection("posts", ({ data }) => {
    return !data.draft && !data.archive && data.lang === "en";
});
const latestPosts = allPosts
    .sort(
        (a, b) =>
            new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
    )
    .slice(0, 3);

const [readingData, podcastData, githubData] = await Promise.all([
    fetchReadingData(),
    fetchPodcastData(),
    fetchGitHubData(),
]);
const currentlyReading = readingData?.currentlyReading?.slice(0, 2) || [];
const yesterdayStats = podcastData?.yesterdayStats;
const yesterdayMinutes = yesterdayStats
    ? Math.round(yesterdayStats.timeListened / 60)
    : null;

// Curated introductions stay useful even when external services are unavailable.
const featuredProjects = [
    {
        name: "tdx",
        description: "Manage todos in plain Markdown from a fast terminal interface.",
        url: "https://github.com/niklas-heer/tdx",
    },
    {
        name: "speed-comparison",
        description: "Compare programming-language performance with an open benchmark suite.",
        url: "https://github.com/niklas-heer/speed-comparison",
    },
].map((project) => {
    const repo = githubData?.pinnedRepos.find((r) => r.name === project.name);
    return {
        ...project,
        stars: repo?.stargazerCount ?? null,
        language: repo?.primaryLanguage
            ? {
                  name: repo.primaryLanguage.name,
                  color: getLanguageColor(
                      repo.primaryLanguage.name,
                      repo.primaryLanguage.color,
                  ),
              }
            : null,
    };
});
const featuredPost =
    allPosts.find((post) => post.id.endsWith("saving-a-markdown-file")) ||
    latestPosts[0];
const newestPost = latestPosts[0];

const cleanTitle = (title: string) => title.replace(/\*\*/g, "");
const formatMonth = (date: Date) =>
    new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric" }).format(
        date,
    );
const formatDay = (date: Date) =>
    new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" }).format(
        date,
    );
const bookAuthor = (book: { contributions?: { author: { name: string } }[] }) =>
    book.contributions?.[0]?.author?.name ?? null;

const socials = [
    { name: "GitHub", href: siteConfig.social.github },
    { name: "LinkedIn", href: siteConfig.social.linkedin },
    { name: "X", href: siteConfig.social.twitter },
    { name: "Email", href: `mailto:${siteConfig.author.email}` },
];
---

<BaseLayout
    title="Home"
    description="Homepage and blog by Niklas Heer - Leadership, DevSecOps and Quality"
>
    <!-- Hero -->
    <section class="hero">
        <div class="hero-heading">
            <img
                src="/assets/images/about/nheer-memoji.png"
                alt=""
                width="88"
                height="88"
                fetchpriority="high"
                class="hero-image"
            />
            <h1 class="hero-name">{siteConfig.author.name}</h1>
        </div>

        <!--
            A short terminal session answers the two questions a visitor has.
            All lines are in the HTML; the script only replays them on load.
        -->
        <div class="terminal" data-terminal>
            <p class="terminal-line terminal-command" data-command="whoami">
                <span class="terminal-prompt" aria-hidden="true">❯</span>
                <span class="terminal-command-text">whoami</span>
            </p>
            <p class="terminal-line terminal-output">
                Engineering manager at Tradebyte, building an internal developer
                platform. On the side I make small terminal tools, read a lot,
                and write about what I learn from both.
            </p>
            <p class="terminal-line terminal-command" data-command="now">
                <span class="terminal-prompt" aria-hidden="true">❯</span>
                <span class="terminal-command-text">now</span>
            </p>
            <dl class="terminal-line terminal-output terminal-now">
                <div class="terminal-now-row">
                    <dt>reading</dt>
                    <dd>
                        {
                            currentlyReading.length > 0 ? (
                                currentlyReading.map((item, index) => (
                                    <>
                                        {index > 0 && <span class="terminal-sep">, </span>}
                                        <a
                                            href={`https://hardcover.app/books/${item.book.slug}`}
                                            target="_blank"
                                            rel="noopener"
                                        >
                                            {item.book.title}
                                        </a>
                                        {bookAuthor(item.book) && (
                                            <span class="terminal-dim"> by {bookAuthor(item.book)}</span>
                                        )}
                                    </>
                                ))
                            ) : (
                                <a href="/reading">the reading list</a>
                            )
                        }
                    </dd>
                </div>
                <div class="terminal-now-row">
                    <dt>listening</dt>
                    <dd>
                        {
                            yesterdayMinutes !== null ? (
                                <>
                                    {yesterdayMinutes} min of podcasts yesterday
                                    <span class="terminal-dim"> · </span>
                                    <a href="/podcasts">stats</a>
                                </>
                            ) : (
                                <a href="/podcasts">podcast stats</a>
                            )
                        }
                    </dd>
                </div>
                {
                    newestPost && (
                        <div class="terminal-now-row">
                            <dt>writing</dt>
                            <dd>
                                <a href={getPostPath(newestPost)}>
                                    {cleanTitle(newestPost.data.title)}
                                </a>
                            </dd>
                        </div>
                    )
                }
            </dl>
            <p class="terminal-line terminal-command terminal-idle" aria-hidden="true">
                <span class="terminal-prompt">❯</span>
                <span class="terminal-cursor"></span>
            </p>
        </div>

        <ul class="hero-socials" aria-label="Elsewhere">
            {
                socials.map((social) => (
                    <li>
                        <a
                            href={social.href}
                            target={social.href.startsWith("mailto:") ? undefined : "_blank"}
                            rel={social.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                        >
                            {social.name}
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>

    <!-- Selected writing -->
    {
        featuredPost && (
            <section class="home-section">
                <h2 class="section-heading">Selected Writing</h2>
                <a href={getPostPath(featuredPost)} class="featured-post">
                    <span class="emoji-tile emoji-tile-large" aria-hidden="true">
                        {featuredPost.data.icon && parseEmoji(featuredPost.data.icon)}
                    </span>
                    <span class="featured-post-body">
                        <span class="featured-post-title">
                            {cleanTitle(featuredPost.data.title)}
                        </span>
                        <span class="featured-post-description">
                            {featuredPost.data.description}
                        </span>
                        <span class="featured-post-meta">
                            {formatMonth(new Date(featuredPost.data.date))}
                        </span>
                    </span>
                </a>
            </section>
        )
    }

    <!-- Latest posts -->
    <section class="home-section">
        <h2 class="section-heading">
            Latest Posts
            <a href="/posts" class="section-more">All posts</a>
        </h2>
        <ul class="post-list">
            {
                latestPosts.map((post) => (
                    <li>
                        <a href={getPostPath(post)} class="post-row">
                            <span class="emoji-tile" aria-hidden="true">
                                {post.data.icon && parseEmoji(post.data.icon)}
                            </span>
                            <span class="post-row-body">
                                <span class="post-row-title">
                                    {cleanTitle(post.data.title)}
                                </span>
                                {post.data.description && (
                                    <span class="post-row-description">
                                        {post.data.description}
                                    </span>
                                )}
                            </span>
                            <time
                                class="post-row-date"
                                datetime={new Date(post.data.date).toISOString()}
                            >
                                {formatDay(new Date(post.data.date))}
                            </time>
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>

    <div class="home-columns">
        <!-- Projects -->
        <section class="home-section">
            <h2 class="section-heading">
                Featured Projects
                <a href="/projects" class="section-more">All projects</a>
            </h2>
            <ul class="project-list">
                {
                    featuredProjects.map((project) => (
                        <li>
                            <a
                                href={project.url}
                                class="project-row"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <span class="project-head">
                                    <span class="project-name">{project.name}</span>
                                    {project.language && (
                                        <span class="project-language">
                                            <span
                                                class="project-language-dot"
                                                style={`background-color: ${project.language.color}`}
                                            />
                                            {project.language.name}
                                        </span>
                                    )}
                                    {project.stars !== null && (
                                        <span class="project-stars">
                                            ★ {project.stars}
                                        </span>
                                    )}
                                </span>
                                <span class="project-description">
                                    {project.description}
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </section>

        <!-- Reading -->
        <section class="home-section">
            <h2 class="section-heading">On the Shelf</h2>
            {
                currentlyReading.length > 0 ? (
                    <div class="shelf">
                        {currentlyReading.map((item) => (
                            <a
                                href={`https://hardcover.app/books/${item.book.slug}`}
                                target="_blank"
                                rel="noopener"
                                class="shelf-book"
                                title={item.book.title}
                            >
                                {item.book.image?.url ? (
                                    <img
                                        src={item.book.image.url}
                                        alt={item.book.title}
                                        width="72"
                                        height="108"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                ) : (
                                    <span class="shelf-placeholder">{item.book.title}</span>
                                )}
                            </a>
                        ))}
                    </div>
                ) : (
                    <p class="shelf-empty">Books, notes, and past reads.</p>
                )
            }
            <a href="/reading" class="shelf-link">See reading list</a>
        </section>
    </div>
</BaseLayout>

<style>
    /* Hero */
    .hero {
        margin-bottom: 4rem;
    }

    .hero-heading {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .hero-image {
        width: 88px;
        height: 88px;
        object-fit: contain;
        flex-shrink: 0;
    }

    .hero-name {
        font-size: clamp(2.5rem, 7vw, 3.75rem);
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1;
        margin: 0;
    }

    /* Terminal */
    .terminal {
        font-family: var(--font-mono);
        font-size: 0.9375rem;
        line-height: 1.6;
        padding: 1.25rem 1.5rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card);
        box-shadow: 0 1px 0 color-mix(in srgb, var(--color-foreground) 4%, transparent) inset;
        margin-bottom: 1.5rem;
    }

    .terminal-line {
        margin: 0;
        overflow-wrap: anywhere;
    }

    .terminal-line + .terminal-command {
        margin-top: 0.75rem;
    }

    .terminal-command {
        display: flex;
        gap: 0.6ch;
        color: var(--color-foreground);
        font-weight: 600;
    }

    .terminal-prompt {
        color: var(--color-accent);
        font-weight: 500;
    }

    .terminal-output {
        color: var(--color-muted);
        padding-left: 2ch;
    }

    .terminal-now-row {
        display: grid;
        grid-template-columns: 10ch minmax(0, 1fr);
        gap: 0 1ch;
    }

    .terminal-now dt {
        color: var(--color-muted);
    }

    .terminal-now dd {
        margin: 0;
        color: var(--color-foreground);
    }

    .terminal-now a,
    .terminal-output a {
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 0.2em;
        text-decoration-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    }

    .terminal-now a:hover,
    .terminal-output a:hover {
        text-decoration-color: currentColor;
    }

    .terminal-dim {
        color: var(--color-muted);
    }

    .terminal-cursor {
        display: inline-block;
        width: 0.6ch;
        height: 1.1em;
        margin-top: 0.2em;
        background: var(--color-accent);
        animation: cursor-blink 1s step-end infinite;
    }

    @keyframes cursor-blink {
        0%,
        50% {
            opacity: 1;
        }
        51%,
        100% {
            opacity: 0;
        }
    }

    /* Replay: hide lines until the script reveals them */
    .terminal[data-playing] .terminal-line {
        display: none;
    }

    .terminal[data-playing] .terminal-line.is-shown {
        display: block;
    }

    .terminal[data-playing] .terminal-command.is-shown {
        display: flex;
    }

    .terminal[data-playing] .terminal-command.is-typing .terminal-command-text::after {
        content: "";
        display: inline-block;
        width: 0.6ch;
        height: 1.1em;
        vertical-align: text-bottom;
        background: var(--color-accent);
        margin-left: 0.1ch;
    }

    @media (max-width: 30rem) {
        .terminal {
            padding: 1rem 1.125rem;
            font-size: 0.875rem;
        }

        .terminal-now-row {
            grid-template-columns: 1fr;
        }

        .terminal-output {
            padding-left: 0;
        }
    }

    .hero-socials {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.25rem;
        font-size: 0.9375rem;
        font-weight: 500;
    }

    .hero-socials a {
        color: var(--color-foreground);
        text-decoration: underline;
        text-underline-offset: 0.25em;
        text-decoration-thickness: 1.5px;
        text-decoration-color: color-mix(in srgb, var(--color-accent) 50%, transparent);
    }

    .hero-socials a:hover {
        color: var(--color-accent);
        text-decoration-color: currentColor;
    }

    /* Sections */
    .home-section {
        margin-bottom: 3rem;
    }

    .home-columns {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0 3rem;
    }

    @media (min-width: 40rem) {
        .home-columns {
            grid-template-columns: 1.2fr 1fr;
        }
    }

    /* Post rows */
    .post-list,
    .project-list {
        display: flex;
        flex-direction: column;
    }

    .post-row {
        display: grid;
        grid-template-columns: 2.5rem minmax(0, 1fr) auto;
        align-items: start;
        gap: 0.875rem;
        padding: 0.875rem 0;
        border-bottom: 1px solid var(--color-border);
        color: var(--color-foreground);
    }

    .post-list li:last-child .post-row {
        border-bottom: none;
    }

    .post-row-body {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        min-width: 0;
    }

    .post-row-title {
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.3;
        text-wrap: balance;
    }

    .post-row:hover .post-row-title {
        color: var(--color-accent);
    }

    .post-row-description {
        font-size: 0.9375rem;
        color: var(--color-muted);
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .post-row-date {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--color-muted);
        white-space: nowrap;
        padding-top: 0.25rem;
    }

    @media (max-width: 30rem) {
        .post-row {
            grid-template-columns: 2.5rem minmax(0, 1fr);
        }

        .post-row-date {
            grid-column: 2;
            padding-top: 0;
        }
    }

    /* Project rows */
    .project-row {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0.875rem 0;
        border-bottom: 1px solid var(--color-border);
        color: var(--color-foreground);
    }

    .project-list li:last-child .project-row {
        border-bottom: none;
    }

    .project-head {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.75rem;
        font-family: var(--font-mono);
        font-size: 0.875rem;
    }

    .project-name {
        font-weight: 600;
        font-size: 0.9375rem;
    }

    .project-row:hover .project-name {
        color: var(--color-accent);
    }

    .project-language,
    .project-stars {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        color: var(--color-muted);
        font-size: 0.8125rem;
    }

    .project-language-dot {
        width: 0.625rem;
        height: 0.625rem;
        border-radius: 50%;
    }

    .project-description {
        font-size: 0.9375rem;
        color: var(--color-muted);
        text-wrap: pretty;
    }

    /* Shelf */
    .shelf {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .shelf-book img,
    .shelf-placeholder {
        width: 72px;
        height: 108px;
        object-fit: cover;
        border-radius: 3px;
        box-shadow:
            0 1px 2px rgba(0, 0, 0, 0.3),
            0 8px 20px rgba(0, 0, 0, 0.25);
        transition: transform 0.2s ease;
    }

    .shelf-placeholder {
        display: flex;
        align-items: center;
        padding: 0.5rem;
        font-size: 0.6875rem;
        line-height: 1.3;
        background: var(--color-surface-raised);
        color: var(--color-muted);
    }

    .shelf-book:hover img {
        transform: translateY(-3px);
    }

    .shelf-empty {
        font-size: 0.9375rem;
        color: var(--color-muted);
        margin-bottom: 1rem;
    }

    .shelf-link {
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: underline;
        text-underline-offset: 0.2em;
        text-decoration-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    }

    .shelf-link:hover {
        text-decoration-color: currentColor;
    }
</style>

<script>
    // Replays the hero terminal once per page load: commands are typed,
    // their output appears in one step. The markup is complete without this.
    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    async function playTerminal() {
        const terminal = document.querySelector<HTMLElement>("[data-terminal]");
        if (!terminal || terminal.dataset.played) return;
        terminal.dataset.played = "true";

        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduceMotion) return;

        const lines = Array.from(terminal.querySelectorAll<HTMLElement>(".terminal-line"));
        terminal.dataset.playing = "true";

        for (const line of lines) {
            // Navigating away mid-replay must not leave hidden lines behind.
            if (!terminal.isConnected) return;
            const command = line.dataset.command;
            line.classList.add("is-shown");
            if (command) {
                const text = line.querySelector<HTMLElement>(".terminal-command-text");
                if (text) {
                    line.classList.add("is-typing");
                    text.textContent = "";
                    await wait(250);
                    for (const char of command) {
                        text.textContent += char;
                        await wait(70 + Math.random() * 60);
                    }
                    await wait(180);
                    line.classList.remove("is-typing");
                }
            } else {
                await wait(120);
            }
        }
        delete terminal.dataset.playing;
    }

    playTerminal();
    document.addEventListener("astro:page-load", playTerminal);
</script>
