---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { parseEmoji } from "../utils/emoji";
import { siteConfig } from "../config";
import { getPostPath } from "../utils/content-metadata";

// Get latest posts
const allPosts = await getCollection("posts", ({ data }) => {
    return !data.draft && !data.archive && data.lang === "en";
});
const latestPosts = allPosts
    .sort(
        (a, b) =>
            new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
    )
    .slice(0, 3);

// Import Hardcover data for reading section
import { fetchReadingData } from "../utils/hardcover";

// Import podcast data
import { fetchPodcastData } from "../utils/database";

const [readingData, podcastData] = await Promise.all([
    fetchReadingData(),
    fetchPodcastData(),
]);
const currentlyReading = readingData?.currentlyReading?.slice(0, 2) || [];
const yesterdayStats = podcastData?.yesterdayStats;
const yesterdayMinutes = yesterdayStats
    ? Math.round(yesterdayStats.timeListened / 60)
    : null;

// Curated introductions stay useful even when external services are unavailable.
const featuredProjects = [
    {
        name: "tdx",
        description: "Manage todos in plain Markdown from a fast terminal interface.",
        url: "https://github.com/niklas-heer/tdx",
    },
    {
        name: "speed-comparison",
        description: "Compare programming-language performance with an open benchmark suite.",
        url: "https://github.com/niklas-heer/speed-comparison",
    },
];
const featuredPost =
    allPosts.find((post) => post.id.endsWith("saving-a-markdown-file")) ||
    latestPosts[0];

const cleanTitle = (title: string) => title.replace(/\*\*/g, "");
const formatMonth = (date: Date) =>
    new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric" }).format(
        date,
    );
const formatDay = (date: Date) =>
    new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" }).format(
        date,
    );

const socials = [
    { name: "GitHub", href: siteConfig.social.github },
    { name: "LinkedIn", href: siteConfig.social.linkedin },
    { name: "X", href: siteConfig.social.twitter },
    { name: "Email", href: `mailto:${siteConfig.author.email}` },
];
---

<BaseLayout
    title="Home"
    description="Homepage and blog by Niklas Heer - Leadership, DevSecOps and Quality"
>
    <!-- Hero -->
    <section class="hero">
        <img
            src="/assets/images/about/nheer-memoji.png"
            alt=""
            width="96"
            height="96"
            fetchpriority="high"
            class="hero-image"
        />
        <h1 class="hero-name">{siteConfig.author.name}</h1>
        <p class="hero-intro">
            Engineering manager at Tradebyte, building an internal developer
            platform. On the side I make small terminal tools, read a lot, and
            write about what I learn from both.
        </p>
        <ul class="hero-socials" aria-label="Elsewhere">
            {
                socials.map((social) => (
                    <li>
                        <a
                            href={social.href}
                            target={social.href.startsWith("mailto:") ? undefined : "_blank"}
                            rel={social.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                        >
                            {social.name}
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>

    <!-- Selected writing: the one loud element on the page -->
    {
        featuredPost && (
            <section class="home-section">
                <h2 class="section-heading">Selected Writing</h2>
                <a href={getPostPath(featuredPost)} class="featured-post">
                    <span class="featured-post-icon" aria-hidden="true">
                        {featuredPost.data.icon && parseEmoji(featuredPost.data.icon)}
                    </span>
                    <span class="featured-post-body">
                        <span class="featured-post-title">
                            {cleanTitle(featuredPost.data.title)}
                        </span>
                        <span class="featured-post-description">
                            {featuredPost.data.description}
                        </span>
                        <span class="featured-post-meta">
                            {formatMonth(new Date(featuredPost.data.date))}
                        </span>
                    </span>
                </a>
            </section>
        )
    }

    <!-- Latest posts -->
    <section class="home-section">
        <h2 class="section-heading">
            Latest Posts
            <a href="/posts" class="section-more">All posts</a>
        </h2>
        <ul class="post-list">
            {
                latestPosts.map((post) => (
                    <li>
                        <a href={getPostPath(post)} class="post-row">
                            <span class="post-row-icon" aria-hidden="true">
                                {post.data.icon && parseEmoji(post.data.icon)}
                            </span>
                            <span class="post-row-title">
                                {cleanTitle(post.data.title)}
                            </span>
                            <time
                                class="post-row-date"
                                datetime={new Date(post.data.date).toISOString()}
                            >
                                {formatDay(new Date(post.data.date))}
                            </time>
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>

    <div class="home-columns">
        <!-- Projects -->
        <section class="home-section">
            <h2 class="section-heading">
                Featured Projects
                <a href="/projects" class="section-more">All projects</a>
            </h2>
            <ul class="project-list">
                {
                    featuredProjects.map((project) => (
                        <li>
                            <a
                                href={project.url}
                                class="project-row"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <span class="project-name">{project.name}</span>
                                <span class="project-description">
                                    {project.description}
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </section>

        <!-- Now -->
        <section class="home-section">
            <h2 class="section-heading">Right Now</h2>
            <ul class="now-list">
                <li class="now-item">
                    <span class="now-icon" aria-hidden="true">📖</span>
                    <div class="now-body">
                        {
                            currentlyReading.length > 0 ? (
                                <>
                                    <span class="now-label">Reading</span>
                                    <div class="now-books">
                                        {currentlyReading.map((item) => (
                                            <a
                                                href={`https://hardcover.app/books/${item.book.slug}`}
                                                target="_blank"
                                                rel="noopener"
                                                class="now-book"
                                                title={item.book.title}
                                            >
                                                {item.book.image?.url && (
                                                    <img
                                                        src={item.book.image.url}
                                                        alt={item.book.title}
                                                        width="44"
                                                        height="66"
                                                        loading="lazy"
                                                        decoding="async"
                                                    />
                                                )}
                                            </a>
                                        ))}
                                    </div>
                                </>
                            ) : (
                                <span class="now-label">Books, notes, and past reads</span>
                            )
                        }
                        <a href="/reading" class="now-link">See reading list</a>
                    </div>
                </li>
                <li class="now-item">
                    <span class="now-icon" aria-hidden="true">🎧</span>
                    <div class="now-body">
                        {
                            yesterdayMinutes !== null ? (
                                <span class="now-label">
                                    <strong>{yesterdayMinutes} min</strong> of podcasts yesterday
                                </span>
                            ) : (
                                <span class="now-label">Tracking my podcast listening</span>
                            )
                        }
                        <a href="/podcasts" class="now-link">See listening stats</a>
                    </div>
                </li>
                <li class="now-item">
                    <span class="now-icon" aria-hidden="true">👋</span>
                    <div class="now-body">
                        <span class="now-label">More about me, my work, and my CV</span>
                        <a href="/about" class="now-link">About me</a>
                    </div>
                </li>
            </ul>
        </section>
    </div>
</BaseLayout>

<style>
    /* Hero */
    .hero {
        margin-bottom: 4rem;
    }

    .hero-image {
        width: 96px;
        height: 96px;
        object-fit: contain;
        margin-bottom: 1.25rem;
        margin-left: -0.5rem;
    }

    .hero-name {
        font-size: clamp(2.75rem, 8vw, 4.25rem);
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 0.98;
        margin-bottom: 1.25rem;
    }

    .hero-intro {
        font-size: 1.25rem;
        line-height: 1.5;
        color: var(--color-muted);
        max-width: 34ch;
        text-wrap: pretty;
        margin-bottom: 1.5rem;
    }

    .hero-socials {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.25rem;
        font-size: 0.9375rem;
        font-weight: 500;
    }

    .hero-socials a {
        color: var(--color-foreground);
        text-decoration: underline;
        text-underline-offset: 0.25em;
        text-decoration-thickness: 1.5px;
        text-decoration-color: color-mix(in srgb, var(--color-accent) 50%, transparent);
    }

    .hero-socials a:hover {
        color: var(--color-accent);
        text-decoration-color: currentColor;
    }

    /* Sections */
    .home-section {
        margin-bottom: 3rem;
    }

    .home-columns {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0 3rem;
    }

    @media (min-width: 40rem) {
        .home-columns {
            grid-template-columns: 1.15fr 1fr;
        }
    }

    /* Featured post */
    .featured-post {
        display: flex;
        gap: 1.25rem;
        padding: 1.5rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-left: 3px solid var(--color-accent);
        border-radius: var(--radius-card);
        color: var(--color-foreground);
        transition: border-color 0.15s ease;
    }

    .featured-post:hover {
        color: var(--color-foreground);
        border-color: color-mix(in srgb, var(--color-accent) 60%, var(--color-border));
        border-left-color: var(--color-accent);
    }

    .featured-post-icon {
        font-size: 2rem;
        line-height: 1;
        flex-shrink: 0;
    }

    .featured-post-body {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 0;
    }

    .featured-post-title {
        font-size: clamp(1.5rem, 3.5vw, 1.875rem);
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.15;
        text-wrap: balance;
    }

    .featured-post:hover .featured-post-title {
        color: var(--color-accent);
    }

    .featured-post-description {
        color: var(--color-muted);
        text-wrap: pretty;
    }

    .featured-post-meta {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--color-muted);
    }

    @media (max-width: 30rem) {
        .featured-post {
            flex-direction: column;
            gap: 0.75rem;
        }
    }

    /* Post rows */
    .post-list,
    .project-list,
    .now-list {
        display: flex;
        flex-direction: column;
    }

    .post-row {
        display: grid;
        grid-template-columns: 1.75rem minmax(0, 1fr) auto;
        align-items: baseline;
        gap: 0.75rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--color-border);
        color: var(--color-foreground);
    }

    .post-list li:last-child .post-row {
        border-bottom: none;
    }

    .post-row:hover {
        color: var(--color-accent);
    }

    .post-row-icon {
        font-size: 1.125rem;
        line-height: 1;
        align-self: center;
    }

    .post-row-title {
        font-weight: 600;
        letter-spacing: -0.01em;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .post-row-date {
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        color: var(--color-muted);
        white-space: nowrap;
    }

    /* Project rows */
    .project-row {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--color-border);
        color: var(--color-foreground);
    }

    .project-list li:last-child .project-row {
        border-bottom: none;
    }

    .project-name {
        font-family: var(--font-mono);
        font-weight: 600;
        font-size: 0.9375rem;
    }

    .project-row:hover .project-name {
        color: var(--color-accent);
    }

    .project-description {
        font-size: 0.9375rem;
        color: var(--color-muted);
        text-wrap: pretty;
    }

    /* Now */
    .now-item {
        display: flex;
        gap: 0.75rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--color-border);
    }

    .now-list li:last-child {
        border-bottom: none;
    }

    .now-icon {
        font-size: 1.125rem;
        line-height: 1.5;
        flex-shrink: 0;
    }

    .now-body {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        min-width: 0;
    }

    .now-label {
        font-size: 0.9375rem;
        color: var(--color-muted);
        line-height: 1.5;
    }

    .now-label strong {
        color: var(--color-foreground);
        font-weight: 600;
    }

    .now-books {
        display: flex;
        gap: 0.5rem;
    }

    .now-book img {
        width: 44px;
        height: 66px;
        object-fit: cover;
        border-radius: 3px;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
    }

    .now-link {
        font-size: 0.9375rem;
        font-weight: 500;
        width: fit-content;
        text-decoration: underline;
        text-underline-offset: 0.2em;
        text-decoration-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    }

    .now-link:hover {
        text-decoration-color: currentColor;
    }
</style>
