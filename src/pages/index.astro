---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialIcon from "../components/SocialIcon.astro";
import ProjectCard from "../components/projects/ProjectCard.astro";
import { getCollection } from "astro:content";
import { parseEmoji } from "../utils/emoji";
import { siteConfig } from "../config";
import { getPostPath } from "../utils/content-metadata";
import { fetchReadingData, getAuthors, getBookUrl, getLatestRead } from "../utils/hardcover";
import { fetchPodcastData } from "../utils/database";
import { getProjectsData } from "../utils/project-data";
import { formatCount } from "../utils/projects";
import { selectedWriting } from "../data/selected-writing";

const allPosts = (
    await getCollection("posts", ({ data }) => {
        return !data.draft && !data.archive && data.lang === "en";
    })
).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Three hand-picked articles open the page; see src/data/selected-writing.ts.
const selected = selectedWriting.map((item) => {
    const post = allPosts.find((candidate) => candidate.id === item.id);
    if (!post) throw new Error(`Selected writing lists "${item.id}", but no published post has that id`);
    return { ...item, post };
});
const [leadArticle, ...sideArticles] = selected;
// The newest posts follow, without repeating a selected one.
const latestPosts = allPosts.filter((post) => !selected.some((item) => item.post.id === post.id)).slice(0, 3);
const newestPost = allPosts[0];

const [readingData, podcastData, projectsData] = await Promise.all([
    fetchReadingData(),
    fetchPodcastData(),
    getProjectsData(),
]);
const currentlyReading = readingData?.currentlyReading ?? [];
const yesterdayStats = podcastData?.yesterdayStats;
const yesterdayMinutes = yesterdayStats ? Math.round(yesterdayStats.timeListened / 60) : null;

const featuredProjects = projectsData.featured.slice(0, 3);
const projectCount = projectsData.projects.length;
const totalStars = projectsData.projects.reduce((sum, project) => sum + (project.stats.stars ?? 0), 0);

// The shelf: what is open now, then the most recently finished, five in all.
const SHELF_SIZE = 5;
const shelf = [
    ...currentlyReading.map((item) => ({ item, reading: true })),
    ...(readingData?.recentlyRead ?? []).map((item) => ({ item, reading: false })),
].slice(0, SHELF_SIZE);

const cleanTitle = (title: string) => title.replace(/\*\*/g, "");
const formatMonth = (date: Date) =>
    new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric" }).format(date);
const formatDay = (date: Date) =>
    new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric" }).format(date);
const readingTime = (post: (typeof allPosts)[number]) =>
    Math.max(1, Math.ceil((post.body || "").split(/\s+/).length / 200));
const finishedLabel = (item: (typeof shelf)[number]["item"]) => {
    const finished = getLatestRead(item)?.finished_at || item.last_read_date;
    return finished ? `Finished ${formatMonth(new Date(finished))}` : "Finished";
};

const socials = [
    { name: "GitHub", href: siteConfig.social.github },
    { name: "Bluesky", href: siteConfig.social.bluesky },
    { name: "LinkedIn", href: siteConfig.social.linkedin },
    { name: "X", href: siteConfig.social.twitter },
    { name: "Email", href: `mailto:${siteConfig.author.email}` },
];

// Everything the interactive prompt can answer without a network request.
const terminalData = {
    sections: [
        { name: "blog", path: "/posts" },
        { name: "reading", path: "/reading" },
        { name: "listening", path: "/listening" },
        { name: "projects", path: "/projects" },
        { name: "reviews", path: "/reviews" },
        { name: "about", path: "/about" },
    ],
    posts: allPosts.slice(0, 5).map((post) => ({
        title: cleanTitle(post.data.title),
        url: getPostPath(post),
        date: formatMonth(new Date(post.data.date)),
    })),
    projects: featuredProjects.map((project) => ({
        name: project.entry.data.title,
        url: project.url,
        description: project.entry.data.tagline,
    })),
    socials,
};
const terminalJson = JSON.stringify(terminalData).replace(/</g, "\\u003c");
---

<BaseLayout
    title="Home"
    description="Homepage and blog by Niklas Heer - Leadership, DevSecOps and Quality"
>
    <div class="home wide-breakout">
        <!-- Hero: who this is, in plain text, beside a small working terminal. -->
        <section class="hero">
            <div class="hero-intro">
                <div class="hero-heading">
                    <img
                        src="/assets/images/about/nheer-memoji.png"
                        alt=""
                        width="88"
                        height="88"
                        fetchpriority="high"
                        class="hero-image"
                    />
                    <h1 class="hero-name">{siteConfig.author.name}</h1>
                </div>
                <p class="hero-lead">
                    Engineering manager at Tradebyte, building an internal developer
                    platform. On the side I make small terminal tools, read a lot,
                    and write about what I learn from both.
                </p>
                <ul class="hero-socials" aria-label="Elsewhere">
                    {
                        socials.map((social) => (
                            <li>
                                <a
                                    href={social.href}
                                    target={social.href.startsWith("mailto:") ? undefined : "_blank"}
                                    rel={social.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                                >
                                    <SocialIcon name={social.name} class="hero-social-icon" />
                                    <span>{social.name}</span>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!--
                The terminal shows what is current and takes commands. All lines
                are in the HTML; the script only replays them on a first visit.
            -->
            <div class="terminal" data-terminal>
                <div class="terminal-bar" aria-hidden="true">
                    <span class="terminal-dots"><i></i><i></i><i></i></span>
                    <span class="terminal-title">niklas@nheer: ~</span>
                </div>
                <div class="terminal-screen">
                    <template data-answer="whoami">
                        <p class="terminal-line terminal-output">
                            Engineering manager at Tradebyte, building an internal developer
                            platform. On the side I make small terminal tools, read a lot,
                            and write about what I learn from both.
                        </p>
                    </template>
                    <p class="terminal-line terminal-command" data-command="now" data-intro>
                        <span class="terminal-prompt" aria-hidden="true">❯</span>
                        <span class="terminal-command-text">now</span>
                    </p>
                    <dl class="terminal-line terminal-output terminal-now" data-intro data-answer="now">
                        <div class="terminal-now-row">
                            <dt>reading</dt>
                            <dd>
                                {
                                    currentlyReading.length > 0 ? (
                                        currentlyReading.slice(0, 2).map((item, index) => (
                                            <>
                                                {index > 0 && <span class="terminal-sep">, </span>}
                                                <a href={getBookUrl(item.book)} target="_blank" rel="noopener">
                                                    {item.book.title}
                                                </a>
                                            </>
                                        ))
                                    ) : (
                                        <a href="/reading">the reading list</a>
                                    )
                                }
                            </dd>
                        </div>
                        <div class="terminal-now-row">
                            <dt>listening</dt>
                            <dd>
                                {
                                    yesterdayMinutes !== null ? (
                                        <>
                                            {yesterdayMinutes} min of podcasts yesterday
                                            <span class="terminal-dim"> · </span>
                                            <a href="/listening">stats</a>
                                        </>
                                    ) : (
                                        <a href="/listening">podcast stats</a>
                                    )
                                }
                            </dd>
                        </div>
                        {
                            newestPost && (
                                <div class="terminal-now-row">
                                    <dt>writing</dt>
                                    <dd>
                                        <a href={getPostPath(newestPost)}>
                                            {cleanTitle(newestPost.data.title)}
                                        </a>
                                    </dd>
                                </div>
                            )
                        }
                    </dl>
                    <div class="terminal-history" data-terminal-history aria-live="polite"></div>
                    <form class="terminal-line terminal-command terminal-input-line" data-terminal-form action="/" method="get">
                        <label class="terminal-prompt" for="terminal-input" aria-hidden="true">❯</label>
                        <input
                            id="terminal-input"
                            class="terminal-input"
                            type="text"
                            name="cmd"
                            autocomplete="off"
                            autocapitalize="off"
                            spellcheck="false"
                            enterkeyhint="send"
                            aria-label="Type a command, for example help"
                            placeholder="type help"
                            data-terminal-input
                        />
                    </form>
                </div>
                <script type="application/json" is:inline data-terminal-data set:html={terminalJson} />
            </div>
        </section>

        <!-- Writing: three selected articles as a typographic lead, then the newest. -->
        <section class="home-section" aria-labelledby="writing-heading">
            <header class="section-head">
                <p class="mono-label is-prompt">Start here</p>
                <h2 id="writing-heading" class="section-heading">
                    Selected writing
                    <a href="/posts" class="section-more">All posts</a>
                </h2>
            </header>

            <div class="lead-grid">
                <article class="lead lead-main">
                    <p class="mono-label"><span class="lead-number">01</span>{leadArticle.lens}</p>
                    <h3 class="lead-title">
                        <a href={getPostPath(leadArticle.post)}>{cleanTitle(leadArticle.post.data.title)}</a>
                    </h3>
                    <p class="lead-sentence">{leadArticle.sentence}</p>
                    <p class="lead-meta">
                        <time datetime={new Date(leadArticle.post.data.date).toISOString()}>
                            {formatMonth(new Date(leadArticle.post.data.date))}
                        </time>
                        <span aria-hidden="true">·</span>
                        {readingTime(leadArticle.post)} min read
                    </p>
                </article>
                <div class="lead-side">
                    {
                        sideArticles.map((item, index) => (
                            <article class="lead">
                                <p class="mono-label"><span class="lead-number">{String(index + 2).padStart(2, "0")}</span>{item.lens}</p>
                                <h3 class="lead-title">
                                    <a href={getPostPath(item.post)}>{cleanTitle(item.post.data.title)}</a>
                                </h3>
                                <p class="lead-sentence">{item.sentence}</p>
                                <p class="lead-meta">
                                    <time datetime={new Date(item.post.data.date).toISOString()}>
                                        {formatMonth(new Date(item.post.data.date))}
                                    </time>
                                    <span aria-hidden="true">·</span>
                                    {readingTime(item.post)} min read
                                </p>
                            </article>
                        ))
                    }
                </div>
            </div>

            <h3 class="mono-label latest-label">Latest posts</h3>
            <ul class="latest-list">
                {
                    latestPosts.map((post) => (
                        <li>
                            <a href={getPostPath(post)} class="latest-post">
                                <span class="emoji-tile" aria-hidden="true">
                                    {post.data.icon && parseEmoji(post.data.icon)}
                                </span>
                                <span class="latest-body">
                                    <time class="latest-date" datetime={new Date(post.data.date).toISOString()}>
                                        {formatDay(new Date(post.data.date))}
                                    </time>
                                    <span class="latest-title">{cleanTitle(post.data.title)}</span>
                                    {post.data.description && (
                                        <span class="latest-description">{post.data.description}</span>
                                    )}
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </section>

        <!-- Projects: the same screenshot cards the Projects page uses. -->
        {
            featuredProjects.length > 0 && (
                <section class="home-section" aria-labelledby="projects-heading">
                    <header class="section-head">
                        <p class="mono-label is-prompt">{projectCount} projects{totalStars > 0 && ` · ${formatCount(totalStars)} stars`}</p>
                        <h2 id="projects-heading" class="section-heading">
                            Featured projects
                            <a href="/projects" class="section-more">All projects</a>
                        </h2>
                    </header>
                    <ul class="home-projects">
                        {featuredProjects.map((project) => (
                            <ProjectCard
                                project={project}
                                now={projectsData.now}
                                heading="h3"
                                sizes="(min-width: 68rem) 21rem, (min-width: 40rem) 30vw, 6.5rem"
                            />
                        ))}
                    </ul>
                </section>
            )
        }

        <!-- Reading: a row of covers standing on a shelf line. -->
        <section class="home-section" aria-labelledby="shelf-heading">
            <header class="section-head">
                <p class:list={["mono-label", "is-prompt", { "is-mark": currentlyReading.length > 0 }]}>{currentlyReading.length > 0 ? "Reading now" : "Reading"}</p>
                <h2 id="shelf-heading" class="section-heading">
                    On the shelf
                    <a href="/reading" class="section-more">See reading list</a>
                </h2>
            </header>
            {
                shelf.length > 0 ? (
                    <ul class="shelf">
                        {shelf.map(({ item, reading }) => (
                            <li class:list={["shelf-item", { "is-reading": reading }]}>
                                <a href={getBookUrl(item.book)} target="_blank" rel="noopener" class="shelf-book">
                                    <span class="shelf-cover">
                                        {item.book.image?.url ? (
                                            <img
                                                src={item.book.image.url}
                                                alt=""
                                                width="160"
                                                height="240"
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        ) : (
                                            <span class="shelf-placeholder" aria-hidden="true">{item.book.title}</span>
                                        )}
                                    </span>
                                    <span class="shelf-caption">
                                        <span class:list={["mono-label", { "is-mark": reading }]}>
                                            {reading ? "Reading now" : finishedLabel(item)}
                                        </span>
                                        <span class="shelf-title">{item.book.title}</span>
                                        <span class="shelf-author">{getAuthors(item.book)}</span>
                                    </span>
                                </a>
                            </li>
                        ))}
                    </ul>
                ) : (
                    <p class="shelf-empty">Books, notes, and past reads.</p>
                )
            }
        </section>
    </div>
</BaseLayout>

<style>
    /* Hero */
    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2rem;
        margin-bottom: 3.5rem;
    }

    .hero-heading {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        margin-bottom: 1.25rem;
    }

    .hero-image {
        width: 4.5rem;
        height: 4.5rem;
        object-fit: contain;
        flex-shrink: 0;
    }

    .hero-name {
        font-size: clamp(var(--text-display), 7vw, var(--text-hero));
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1;
        margin: 0;
    }

    .hero-lead {
        max-width: 34rem;
        margin-bottom: 1.5rem;
        font-size: var(--text-lead);
        line-height: 1.5;
        letter-spacing: -0.01em;
        color: var(--color-foreground);
        text-wrap: pretty;
    }

    .hero-socials {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.25rem;
        font-size: var(--text-small);
        font-weight: 500;
    }

    .hero-socials a {
        display: inline-flex;
        align-items: center;
        gap: 0.4em;
        /* Comfortable to tap without growing the row. */
        padding-block: 0.25rem;
        color: var(--color-foreground);
        text-decoration: underline;
        text-underline-offset: 0.25em;
        text-decoration-thickness: 1.5px;
        text-decoration-color: color-mix(in srgb, var(--color-accent) 50%, transparent);
    }

    .hero-socials a:hover {
        color: var(--color-accent);
        text-decoration-color: currentColor;
    }

    .hero-socials a :global(.hero-social-icon) {
        color: var(--color-muted);
        transition: color 150ms ease;
    }

    .hero-socials a:hover :global(.hero-social-icon) {
        color: currentColor;
    }

    @media (min-width: 56rem) {
        .hero {
            grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);
            align-items: start;
            gap: 3.5rem;
            margin-bottom: 4.5rem;
        }

        .hero-image {
            width: 5.5rem;
            height: 5.5rem;
        }

        .hero-heading {
            gap: 1rem;
        }
    }

    /* Sections */
    .home-section {
        margin-bottom: 3.5rem;
    }

    .home-section:last-child {
        margin-bottom: 0;
    }

    @media (min-width: 56rem) {
        .home-section {
            margin-bottom: 4.5rem;
        }
    }

    /* Selected writing: one lead article and two beside it, set in type alone. */
    .lead-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        border-top: 1px solid var(--color-border);
    }

    .lead {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding-block: 1.5rem;
        border-bottom: 1px solid var(--color-border);
    }

    .lead-number {
        margin-right: 0.75em;
        color: var(--color-accent);
    }

    .lead-title {
        font-size: var(--text-lead);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.2;
        text-wrap: balance;
    }

    .lead-main .lead-title {
        font-size: clamp(var(--text-heading), 4.4vw, var(--text-display));
        font-weight: 750;
        letter-spacing: -0.035em;
        line-height: 1.05;
    }

    .lead-title a {
        color: var(--color-foreground);
        text-decoration: underline;
        text-decoration-thickness: 0.06em;
        text-underline-offset: 0.16em;
        text-decoration-color: transparent;
        transition:
            color 0.15s ease,
            text-decoration-color 0.15s ease;
    }

    .lead-title a:hover {
        color: var(--color-accent);
        text-decoration-color: currentColor;
    }

    .lead-sentence {
        max-width: 34rem;
        color: var(--color-muted);
        text-wrap: pretty;
    }

    .lead-main .lead-sentence {
        font-size: var(--text-lead);
        line-height: 1.45;
        color: var(--color-foreground);
    }

    .lead-meta {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.25rem;
        font-family: var(--font-mono);
        font-size: var(--text-label);
        color: var(--color-muted);
    }

    @media (min-width: 56rem) {
        .lead-grid {
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
            border-bottom: 1px solid var(--color-border);
        }

        .lead {
            border-bottom: none;
        }

        .lead-main {
            gap: 0.875rem;
            padding: 2rem 3rem 2rem 0;
        }

        .lead-main .lead-meta {
            padding-top: 0.5rem;
        }

        .lead-side {
            display: flex;
            flex-direction: column;
            padding-left: 2.5rem;
            border-left: 1px solid var(--color-border);
        }

        .lead-side .lead {
            flex: 1;
            justify-content: center;
            padding-block: 1.5rem;
        }

        .lead-side .lead + .lead {
            border-top: 1px solid var(--color-border);
        }
    }

    /* Latest posts */
    .latest-label {
        margin: 1.75rem 0 0.5rem;
    }

    .latest-list {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
    }

    .latest-post {
        display: grid;
        grid-template-columns: 2.5rem minmax(0, 1fr);
        align-items: start;
        gap: 0.875rem;
        padding: 0.875rem 0;
        border-bottom: 1px solid var(--color-border);
        color: var(--color-foreground);
    }

    .latest-list li:last-child .latest-post {
        border-bottom: none;
    }

    .latest-body {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        min-width: 0;
    }

    .latest-date {
        font-family: var(--font-mono);
        font-size: var(--text-label);
        color: var(--color-muted);
    }

    .latest-title {
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.3;
        text-wrap: balance;
    }

    .latest-post:hover .latest-title {
        color: var(--color-accent);
    }

    .latest-description {
        font-size: var(--text-small);
        color: var(--color-muted);
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    @media (min-width: 56rem) {
        .latest-list {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 2.5rem;
        }

        .latest-post {
            padding: 0.5rem 0 0;
            border-bottom: none;
        }
    }

    /* Featured projects */
    .home-projects {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0.75rem;
    }

    @media (min-width: 40rem) {
        .home-projects {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1rem;
        }
    }

    /*
     * Shelf: covers stand on one continuous line, captions hang below it.
     * The cells touch so the line runs unbroken; the spacing is inside them.
     */
    .shelf {
        --shelf-gap: 0.875rem;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .shelf-book {
        display: block;
        color: var(--color-foreground);
    }

    .shelf-cover {
        display: block;
        padding: 0 var(--shelf-gap) 0.625rem 0;
        border-bottom: 1px solid var(--color-border);
    }

    .shelf-cover img,
    .shelf-placeholder {
        display: block;
        width: 100%;
        max-width: 8.5rem;
        height: auto;
        aspect-ratio: 2 / 3;
        object-fit: cover;
        border-radius: 3px;
        box-shadow:
            0 1px 2px rgb(0 0 0 / 0.3),
            0 8px 20px rgb(0 0 0 / 0.25);
        transition: transform 0.2s ease;
    }

    .shelf-placeholder {
        display: flex;
        align-items: center;
        padding: 0.5rem;
        font-size: var(--text-label);
        line-height: 1.3;
        background: var(--color-surface-raised);
        color: var(--color-muted);
    }

    .shelf-book:hover img {
        transform: translateY(-4px);
    }

    /* The open book carries the amber mark on its stretch of the line. */
    .shelf-item.is-reading .shelf-cover {
        border-bottom: 2px solid var(--color-mark);
        padding-bottom: calc(0.625rem - 1px);
    }

    .shelf-caption {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        padding: 0.625rem var(--shelf-gap) 0 0;
    }

    .shelf-caption .mono-label {
        letter-spacing: 0.04em;
    }

    .shelf-title {
        font-size: var(--text-small);
        font-weight: 600;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .shelf-book:hover .shelf-title {
        color: var(--color-accent);
    }

    .shelf-author {
        font-size: var(--text-small);
        color: var(--color-muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .shelf-empty {
        color: var(--color-muted);
    }

    /* Phones show four covers; names stay available to assistive technology. */
    @media (max-width: 39.99rem) {
        .shelf-item:nth-child(n + 5) {
            display: none;
        }

        .shelf-title,
        .shelf-author {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
            white-space: nowrap;
        }
    }

    @media (min-width: 40rem) {
        .shelf {
            --shelf-gap: 1.5rem;
            grid-template-columns: repeat(5, minmax(0, 1fr));
        }
    }
</style>

<style is:global>
    /* Terminal: always a dark screen, in both themes; its palette is in global.css. */
    .terminal {
        font-family: var(--font-mono);
        font-size: var(--text-small);
        line-height: 1.6;
        color: var(--term-fg);
        background: var(--term-bg);
        border: 1px solid var(--term-border);
        border-radius: var(--radius-card);
        box-shadow:
            0 1px 0 rgb(255 255 255 / 0.04) inset,
            0 24px 48px -24px rgb(0 0 0 / 0.6);
        overflow: hidden;
        cursor: default;
    }

    .terminal .terminal-bar {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 0.5rem 0.875rem;
        background: var(--term-bar);
        border-bottom: 1px solid var(--term-border);
    }

    .terminal .terminal-dots {
        display: flex;
        gap: 0.375rem;
    }

    .terminal .terminal-dots i {
        width: 0.625rem;
        height: 0.625rem;
        border-radius: 50%;
        background: color-mix(in srgb, var(--term-muted) 45%, transparent);
    }

    .terminal .terminal-title {
        font-size: var(--text-label);
        color: var(--term-muted);
        letter-spacing: 0.01em;
    }

    .terminal:focus-within {
        border-color: color-mix(in srgb, var(--term-accent) 55%, var(--term-border));
    }

    /* The screen is as tall as its lines and scrolls once a session gets long. */
    .terminal .terminal-screen {
        padding: 1rem 1.25rem 1.125rem;
        max-height: 24rem;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .terminal.is-cleared [data-intro] {
        display: none;
    }

    .terminal .terminal-input-line {
        align-items: center;
    }

    .terminal .terminal-input {
        flex: 1;
        min-width: 0;
        padding: 0;
        background: none;
        border: none;
        outline: none;
        color: var(--term-fg);
        font: inherit;
        font-weight: 600;
        caret-color: var(--term-accent);
    }

    .terminal .terminal-input::placeholder {
        color: var(--term-muted);
        font-weight: 400;
        opacity: 1;
    }

    .terminal .terminal-list {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        padding-left: 2ch;
        color: var(--term-muted);
    }

    .terminal .terminal-list.is-row {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0 2ch;
    }

    .terminal .terminal-list a {
        color: var(--term-accent);
        text-decoration: underline;
        text-underline-offset: 0.2em;
        text-decoration-color: color-mix(in srgb, var(--term-accent) 45%, transparent);
    }

    .terminal .terminal-list a:hover {
        color: var(--term-accent-hover);
        text-decoration-color: currentColor;
    }

    .terminal .terminal-list kbd {
        color: var(--term-fg);
        font-weight: 600;
        display: inline-block;
        min-width: 10ch;
    }

    .terminal .terminal-error {
        color: var(--term-error);
    }

    .terminal .terminal-line {
        margin: 0;
        overflow-wrap: anywhere;
    }

    .terminal .terminal-line + .terminal-command,
    .terminal .terminal-history:not(:empty) + .terminal-command {
        margin-top: 0.625rem;
    }

    .terminal .terminal-command {
        display: flex;
        gap: 0.6ch;
        color: var(--term-fg);
        font-weight: 600;
    }

    .terminal .terminal-prompt {
        color: var(--term-accent);
        font-weight: 500;
    }

    .terminal .terminal-output {
        color: var(--term-muted);
        padding-left: 2ch;
    }

    .terminal .terminal-now-row {
        display: grid;
        grid-template-columns: 10ch minmax(0, 1fr);
        gap: 0 1ch;
    }

    .terminal .terminal-now dt {
        color: var(--term-muted);
    }

    .terminal .terminal-now dd {
        margin: 0;
        color: var(--term-fg);
    }

    .terminal .terminal-now a,
    .terminal .terminal-output a {
        color: var(--term-accent);
        text-decoration: underline;
        text-underline-offset: 0.2em;
        text-decoration-color: color-mix(in srgb, var(--term-accent) 45%, transparent);
    }

    .terminal .terminal-now a:hover,
    .terminal .terminal-output a:hover {
        color: var(--term-accent-hover);
        text-decoration-color: currentColor;
    }

    .terminal .terminal-dim {
        color: var(--term-muted);
    }

    /*
     * Replay. Lines keep their place and stay invisible until the script
     * reveals them; the part of a line not typed yet is invisible too. The
     * caret is drawn over the next character's cell and takes no room.
     */
    .terminal[data-playing] .terminal-line,
    .terminal[data-playing] .terminal-now-row {
        visibility: hidden;
    }

    .terminal[data-playing] .terminal-line.is-shown,
    .terminal[data-playing] .terminal-now-row.is-shown {
        visibility: visible;
    }

    .terminal .terminal-untyped {
        visibility: hidden;
    }

    .terminal .terminal-caret {
        margin-right: -0.6ch;
        border-right: 0.6ch solid var(--term-accent);
    }

    @media (max-width: 30rem) {
        .terminal .terminal-screen {
            padding: 0.875rem 1rem 1rem;
        }

        .terminal .terminal-now-row {
            grid-template-columns: 1fr;
        }

        .terminal .terminal-now dt {
            font-size: var(--text-label);
        }

        .terminal .terminal-output {
            padding-left: 0;
        }
    }
</style>

<script>
    // The hero terminal replays a short intro on load, then becomes a small
    // interactive shell. The markup is complete without JavaScript, reduced
    // motion skips the replay, and a click on the screen finishes it early.
    // Lines wait invisibly in their final place and are typed where they stand,
    // so the replay never changes the layout.
    import { navigate } from "astro:transitions/client";

    type Section = { name: string; path: string };
    type TerminalData = {
        sections: Section[];
        posts: { title: string; url: string; date: string }[];
        projects: { name: string; url: string; description: string }[];
        socials: { name: string; href: string }[];
    };
    type Command = { help: string; run: (args: string[]) => void | Promise<void> };

    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    function setupShell(terminal: HTMLElement) {
        const dataNode = terminal.querySelector("[data-terminal-data]");
        const history = terminal.querySelector<HTMLElement>("[data-terminal-history]");
        const form = terminal.querySelector<HTMLFormElement>("[data-terminal-form]");
        const input = terminal.querySelector<HTMLInputElement>("[data-terminal-input]");
        const screen = terminal.querySelector<HTMLElement>(".terminal-screen");
        if (!dataNode || !history || !form || !input || !screen) return;
        const data: TerminalData = JSON.parse(dataNode.textContent || "{}");

        const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text = "") => {
            const node = document.createElement(tag);
            node.className = className;
            if (text) node.textContent = text;
            return node;
        };
        const link = (text: string, href: string) => {
            const a = el("a", "", text);
            a.href = href;
            if (/^https?:/.test(href)) {
                a.target = "_blank";
                a.rel = "noopener noreferrer";
            }
            return a;
        };
        const print = (...nodes: Node[]) => {
            history.append(...nodes);
            screen.scrollTop = screen.scrollHeight;
        };
        const say = (text: string, className = "terminal-output") =>
            print(el("p", `terminal-line ${className}`, text));
        const fail = (text: string) => say(text, "terminal-output terminal-error");
        const list = (rows: (string | Node)[][], row = false) => {
            const ul = el("ul", `terminal-list${row ? " is-row" : ""}`);
            for (const cells of rows) {
                const li = el("li", "");
                cells.forEach((cell, index) => {
                    if (index > 0) li.append(" ");
                    li.append(cell);
                });
                ul.append(li);
            }
            print(ul);
        };
        const dim = (text: string) => el("span", "terminal-dim", text);
        const echo = (command: string) => {
            const p = el("p", "terminal-line terminal-command");
            p.append(el("span", "terminal-prompt", "❯"), " ", el("span", "", command));
            print(p);
        };
        const replay = (name: string) => {
            // An answer is either a line on the screen or a template kept off it.
            const found = terminal.querySelector<HTMLElement>(`[data-answer="${name}"]`);
            const answer = found instanceof HTMLTemplateElement ? found.content.firstElementChild : found;
            if (!answer) return;
            const clone = answer.cloneNode(true) as HTMLElement;
            clone.removeAttribute("data-intro");
            clone.removeAttribute("data-answer");
            clone.classList.add("is-shown");
            clone.querySelectorAll(".terminal-now-row").forEach((row) => row.classList.add("is-shown"));
            print(clone);
        };
        const findSection = (name: string) => {
            const aliases: Record<string, string> = { posts: "blog", podcasts: "listening", "~": "home", "..": "home", "/": "home" };
            const wanted = (aliases[name] ?? name).replace(/\/$/, "");
            if (wanted === "home") return { name: "home", path: "/" };
            return data.sections.find((section) => section.name === wanted);
        };

        const commands: Record<string, Command> = {
            help: {
                help: "list the commands",
                run: () => list(Object.entries(commands).map(([name, { help }]) => [el("kbd", "", name), dim(help)])),
            },
            whoami: { help: "who runs this site", run: () => replay("whoami") },
            now: { help: "reading, hearing, writing", run: () => replay("now") },
            ls: {
                help: "list the sections",
                run: () => list(data.sections.map((section) => [link(`${section.name}/`, section.path)]), true),
            },
            cd: {
                help: "open a section",
                run: async ([target = ""]) => {
                    const section = findSection(target);
                    if (!section) return fail(`cd: no such directory: ${target || "(none)"}. Try ls.`);
                    say(`opening ${section.path}`);
                    await wait(150);
                    await navigate(section.path);
                },
            },
            posts: {
                help: "the newest posts",
                run: () => list(data.posts.map((post) => [link(post.title, post.url), dim(post.date)])),
            },
            projects: {
                help: "featured open source",
                run: () => list(data.projects.map((project) => [link(project.name, project.url), dim(project.description)])),
            },
            contact: {
                help: "where to find me",
                run: () => list(data.socials.map((social) => [link(social.name, social.href)]), true),
            },
            theme: {
                help: "switch light and dark",
                run: () => {
                    document.querySelector<HTMLElement>("[data-theme-toggle]")?.click();
                    say(`switched to ${document.documentElement.dataset.theme} theme`);
                },
            },
            inky: {
                help: "ask the octopus",
                run: () => {
                    const comments = (window as any).inkyComments as { comment: string }[] | undefined;
                    const pick = comments?.[Math.floor(Math.random() * comments.length)];
                    say(pick ? `🐙 ${pick.comment}` : "🐙 Inky is below decks. Try again later.");
                },
            },
            clear: {
                help: "clear the screen",
                run: () => {
                    history.replaceChildren();
                    terminal.classList.add("is-cleared");
                },
            },
            echo: { help: "repeat after you", run: (args) => say(args.join(" ")) },
            pwd: { help: "where you are", run: () => say("/home/niklas") },
            date: { help: "today", run: () => say(new Date().toString()) },
        };
        const hidden: Record<string, Command> = {
            sudo: { help: "", run: () => fail("niklas is not in the sudoers file. This incident will be reported to Inky. 🐙") },
            rm: { help: "", run: (args) => fail(args.some((a) => a.startsWith("-r")) ? "Nice try. Inky keeps backups." : "rm: permission denied") },
            exit: { help: "", run: () => say("There is no exit. Try cd blog instead.") },
            logout: { help: "", run: () => say("There is no exit. Try cd blog instead.") },
            vim: { help: "", run: () => say("Even here you cannot leave vim. Try help.") },
            open: { help: "", run: (args) => commands.cd.run(args) },
            cat: { help: "", run: (args) => commands.cd.run(args) },
        };

        const entered: string[] = [];
        let cursor = 0;

        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            const raw = input.value.trim();
            input.value = "";
            echo(raw);
            if (!raw) return;
            entered.push(raw);
            cursor = entered.length;
            const [name, ...args] = raw.split(/\s+/);
            const command = commands[name] ?? hidden[name];
            if (!command) return fail(`command not found: ${name}. Try help.`);
            await command.run(args);
        });

        input.addEventListener("keydown", (event) => {
            if (event.key === "ArrowUp" || event.key === "ArrowDown") {
                if (entered.length === 0) return;
                event.preventDefault();
                cursor = Math.max(0, Math.min(entered.length, cursor + (event.key === "ArrowUp" ? -1 : 1)));
                input.value = entered[cursor] ?? "";
            } else if (event.key === "Tab" && input.value) {
                const [name, partial] = input.value.split(/\s+/);
                const pool = partial === undefined
                    ? Object.keys(commands)
                    : name === "cd" ? data.sections.map((section) => section.name) : [];
                const prefix = partial ?? name;
                const match = pool.find((candidate) => candidate.startsWith(prefix));
                if (match) {
                    event.preventDefault();
                    input.value = partial === undefined ? `${match} ` : `${name} ${match}`;
                }
            } else if (event.key === "l" && event.ctrlKey) {
                event.preventDefault();
                commands.clear.run([]);
            }
        });

        terminal.addEventListener("click", (event) => {
            if (terminal.dataset.playing) return;
            if ((event.target as Element).closest("a, input")) return;
            input.focus({ preventScroll: true });
        });
    }

    async function playTerminal() {
        const terminal = document.querySelector<HTMLElement>("[data-terminal]");
        if (!terminal || terminal.dataset.played) return;
        terminal.dataset.played = "true";
        setupShell(terminal);

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        try {
            if (sessionStorage.getItem("terminal-intro")) return;
            sessionStorage.setItem("terminal-intro", "seen");
        } catch {
            // Without storage the intro simply replays on every visit.
        }

        // A click or any key press finishes the intro early.
        let skip = false;
        const requestSkip = () => { skip = true; };
        terminal.addEventListener("click", requestSkip, { once: true });
        document.addEventListener("keydown", requestSkip, { once: true });
        const pause = (ms: number) => (skip ? Promise.resolve() : wait(ms));

        // Types every text node inside an element, in document order. Each text
        // node is split into a visible "typed" part and an invisible rest, so
        // the text wraps exactly as it will when finished.
        async function typeInto(element: HTMLElement, perChar: number) {
            const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT);
            const nodes: Text[] = [];
            let current = walker.nextNode();
            while (current) {
                // Whitespace between elements stays as it is: wrapping it would
                // add boxes to the grid rows.
                if (current.textContent?.trim()) nodes.push(current as Text);
                current = walker.nextNode();
            }
            const parts = nodes.map((node) => {
                const typed = document.createElement("span");
                const rest = document.createElement("span");
                rest.className = "terminal-untyped";
                rest.textContent = node.textContent ?? "";
                const holder = document.createDocumentFragment();
                holder.append(typed, rest);
                node.replaceWith(holder);
                return { node, typed, rest };
            });
            for (const { node, typed, rest } of parts) {
                typed.className = "terminal-caret";
                for (const char of rest.textContent ?? "") {
                    if (skip) break;
                    typed.textContent += char;
                    rest.textContent = (rest.textContent ?? "").slice(char.length);
                    if (char.trim()) await wait(perChar + Math.random() * perChar);
                }
                // Put the original text node back once it is fully typed (or skipped).
                rest.remove();
                typed.replaceWith(node);
            }
        }

        const lines = Array.from(terminal.querySelectorAll<HTMLElement>(".terminal-line"));
        terminal.dataset.playing = "true";
        await pause(400);

        for (const line of lines) {
            // Navigating away mid-replay must not leave hidden lines behind.
            if (!terminal.isConnected) return;
            line.classList.add("is-shown");
            if (line.dataset.command) {
                const text = line.querySelector<HTMLElement>(".terminal-command-text");
                if (text) await typeInto(text, 55);
                await pause(200);
            } else if (line.classList.contains("terminal-now")) {
                for (const row of line.querySelectorAll<HTMLElement>(".terminal-now-row")) {
                    row.classList.add("is-shown");
                    await typeInto(row, 7);
                    await pause(140);
                }
            } else if (line.classList.contains("terminal-output")) {
                await typeInto(line, 6);
                await pause(320);
            }
        }
        delete terminal.dataset.playing;
        document.removeEventListener("keydown", requestSkip);
    }

    playTerminal();
    document.addEventListener("astro:page-load", playTerminal);
</script>
