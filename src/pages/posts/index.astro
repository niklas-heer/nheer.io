---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { parseEmoji, parseText } from '../../utils/emoji';

// Get all posts, filter out drafts and archive posts
const allPosts = await getCollection('posts', ({ data }) => {
  return !data.draft && !data.archive && data.lang === 'en';
});

// Sort by date descending
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Group posts by year
const postsByYear = sortedPosts.reduce((acc, post) => {
  const year = new Date(post.data.date).getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {} as Record<number, typeof sortedPosts>);

// Get years sorted descending
const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric'
  }).format(date);
}

function getPostUrl(post: typeof sortedPosts[0]): string {
  const date = new Date(post.data.date);
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const slug = post.id.split('/').pop();
  return `/posts/${year}/${month}/${slug}/`;
}
---

<BaseLayout title="Blog" description="Blog posts by Niklas Heer about Leadership, DevSecOps, and Quality">
  <div class="page-header">
    <h1 class="page-title" style="view-transition-name: page-title;">Blog</h1>
    <p class="page-subtitle">Small tools, engineering leadership, and the occasional detour. {sortedPosts.length} posts since {years[years.length - 1]}.</p>
  </div>

  <div class="posts-container">
    {years.map((year) => (
      <section class="year-section">
        <h2 class="year-label">{year}</h2>
        <ul class="posts-list">
          {postsByYear[year].map((post) => (
            <li>
              <a href={getPostUrl(post)} class="post-item">
                <span class="post-icon" aria-hidden="true">
                  {post.data.icon ? parseEmoji(post.data.icon) : '📄'}
                </span>
                <span class="post-content">
                  <span class="post-title" set:html={parseText(post.data.title)} />
                  {post.data.description && (
                    <span class="post-description" set:html={parseText(post.data.description)} />
                  )}
                </span>
                <time class="post-date" datetime={new Date(post.data.date).toISOString()}>
                  {formatDate(new Date(post.data.date))}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  {years.length === 0 && (
    <p class="text-muted">No posts yet.</p>
  )}

  <p class="archive-note">
    Looking for the early years? The <a href="/archive">archive</a> has the older posts, mostly in German.
  </p>
</BaseLayout>

<style>
  .posts-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .year-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  @media (min-width: 40rem) {
    .year-section {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  .year-label {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-muted);
    padding-top: 0.875rem;
  }

  .year-label::before {
    content: "❯ ";
    color: var(--color-accent);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-top: 1px solid var(--color-border);
  }

  .post-item {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem 0.875rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-foreground);
  }

  .post-icon {
    font-size: 1.25rem;
    line-height: 1;
    align-self: start;
    padding-top: 0.125rem;
  }

  .post-content {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .post-title {
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    text-wrap: balance;
  }

  .post-item:hover .post-title {
    color: var(--color-accent);
  }

  .post-description {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .post-item {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .post-date {
      grid-column: 2;
    }
  }

  .archive-note {
    margin-top: 3rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .archive-note a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
  }

  .archive-note a:hover {
    text-decoration-color: currentColor;
  }
</style>
