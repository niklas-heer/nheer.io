---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found" description="The page you're looking for doesn't exist">
  <div class="py-12">
    <p class="font-mono text-accent mb-4"><span aria-hidden="true">❯ </span>404: not found</p>
    <h1 class="page-title">This page doesn't exist.</h1>
    <p class="page-subtitle mb-8">
      It may have moved, or the link was never right. The <a href="/posts">blog</a> and the <a href="/">homepage</a> are good places to start over.
    </p>
  </div>
</BaseLayout>
