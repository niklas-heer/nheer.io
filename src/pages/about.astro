---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";
import CvPreview from "../components/CvPreview.astro";
import SocialIcon from "../components/SocialIcon.astro";

const connectLinks = [
    { name: "LinkedIn", href: siteConfig.social.linkedin },
    { name: "GitHub", href: siteConfig.social.github },
    { name: "Bluesky", href: siteConfig.social.bluesky },
    { name: "Email", href: `mailto:${siteConfig.author.email}` },
];

const tradebbyteStartDate = new Date(2015, 8, 1); // September 2015
const now = new Date();
const yearsAtTradebyte = Math.floor(
    (now.getTime() - tradebbyteStartDate.getTime()) /
        (1000 * 60 * 60 * 24 * 365.25),
);
---

<BaseLayout
    title="About"
    description="About Niklas Heer - Engineering Manager, Central Platform Services at Tradebyte. Experience, skills, and downloadable CV."
>
    <div class="about-hero">
        <div class="about-image-container">
            <img
                src="/assets/images/about/nheer-memoji.png"
                alt="Niklas Heer"
                class="about-image"
                style="view-transition-name: profile-image;"
            />
        </div>
        <h1 class="about-title" style="view-transition-name: page-title;">
            About Me
        </h1>
        <p class="about-tagline">
            Engineering Manager · Central Platform Services · Tradebyte
        </p>
    </div>

    <div class="about-content">
        <section class="about-section about-intro">
            <p class="intro-text">Hi, I am Niklas. 👋</p>
            <p>
                I'm an Engineering Manager at <a
                    href="https://www.tradebyte.com/">Tradebyte</a
                >
                (Zalando Group), leading up to 9 platform and software engineers building our Internal Developer
                Platform. We make life easier for engineering teams by providing the
                tools and infrastructure they need to ship great software.
            </p>
            <p>
                I care about ownership, honesty, and building things that
                actually help people. When I'm not wrangling AWS costs or
                leadership challenges, you'll find me reading, listening to
                podcasts, or tinkering with side projects.
            </p>
        </section>

        <CvPreview />

        <section class="about-section">
            <h2 class="section-title">
                <span class="section-icon">🛠️</span>
                Skills
            </h2>
            <div class="skills-cloud">
                <span class="skill-tag highlight">Go</span>
                <span class="skill-tag highlight">Python</span>
                <span class="skill-tag">PHP</span>
                <span class="skill-tag highlight">JS/TS</span>
                <span class="skill-tag">Elixir</span>
                <span class="skill-tag">Svelte</span>
                <span class="skill-tag">SQL</span>
                <span class="skill-tag">CSS</span>
                <span class="skill-tag">Bash</span>
                <span class="skill-tag highlight">Docker</span>
                <span class="skill-tag highlight">AWS</span>
                <span class="skill-tag highlight">Kubernetes</span>
                <span class="skill-tag">GitLab-CI</span>
                <span class="skill-tag">GitHub-CI</span>
                <span class="skill-tag">Earthly</span>
                <span class="skill-tag">ArgoCD</span>
                <span class="skill-tag">Vault</span>
            </div>
        </section>

        <section class="about-section">
            <h2 class="section-title">
                <span class="section-icon">🌍</span>
                Languages
            </h2>
            <div class="languages-list">
                <div class="language-item">
                    <span class="language-flag">🇩🇪</span>
                    <span class="language-name">German</span>
                    <span class="language-level">Native</span>
                </div>
                <div class="language-item">
                    <span class="language-flag">🇬🇧</span>
                    <span class="language-name">English</span>
                    <span class="language-level">Fluent</span>
                </div>
            </div>
        </section>

        <section class="about-section">
            <h2 class="section-title">
                <span class="section-icon">💼</span>
                Work Experience
            </h2>

            <div class="timeline">
                <div class="timeline-company">
                    <div class="company-header">
                        <img
                            src="https://www.tradebyte.com/favicon.ico"
                            alt="Tradebyte"
                            class="company-logo"
                        />
                        <div>
                            <h3>
                                <a href="https://www.tradebyte.com/"
                                    >Tradebyte Software GmbH</a
                                >
                            </h3>
                            <span class="company-period"
                                >2015 - Present ({yearsAtTradebyte} years)</span
                            >
                        </div>
                    </div>
                    <div class="timeline-roles">
                        <div class="role current">
                            <span class="role-dot"></span>
                            <div class="role-content">
                                <span class="role-title"
                                    >Engineering Manager Central Platform Services (CPS)</span
                                >
                                <span class="role-period"
                                    >Jun 2024 - Present</span
                                >
                            </div>
                        </div>
                        <div class="role">
                            <span class="role-dot"></span>
                            <div class="role-content">
                                <span class="role-title"
                                    >Acting Head of Engineering Product & Tech
                                    Platform</span
                                >
                                <span class="role-period"
                                    >Oct 2023 - Jun 2024</span
                                >
                            </div>
                        </div>
                        <div class="role">
                            <span class="role-dot"></span>
                            <div class="role-content">
                                <span class="role-title"
                                    >Senior Team Lead Central Platform Services</span
                                >
                                <span class="role-period"
                                    >Mar 2022 - Oct 2023</span
                                >
                            </div>
                        </div>
                        <div class="role">
                            <span class="role-dot"></span>
                            <div class="role-content">
                                <span class="role-title"
                                    >Team Lead Central Platform Services</span
                                >
                                <span class="role-period"
                                    >Nov 2019 - Mar 2022</span
                                >
                            </div>
                        </div>
                        <div class="role">
                            <span class="role-dot"></span>
                            <div class="role-content">
                                <span class="role-title"
                                    >DevOps and Quality Engineer</span
                                >
                                <span class="role-period"
                                    >Aug 2018 - Nov 2019</span
                                >
                            </div>
                        </div>
                        <div class="role">
                            <span class="role-dot"></span>
                            <div class="role-content">
                                <span class="role-title"
                                    >Software Developer</span
                                >
                                <span class="role-period"
                                    >Jul 2017 - Aug 2018</span
                                >
                            </div>
                        </div>
                        <div class="role">
                            <span class="role-dot"></span>
                            <div class="role-content">
                                <span class="role-title"
                                    >IT Specialist for Application Development</span
                                >
                                <span class="role-period"
                                    >Sep 2015 - Jul 2017</span
                                >
                            </div>
                        </div>
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <h3>Web Frontend Developer</h3>
                        <p class="timeline-company-name">
                            <a href="https://bertschinnovation.com/"
                                >Bertsch Innovation GmbH</a
                            >
                        </p>
                        <span class="timeline-period"
                            >Nov 2013 - Aug 2015 · Working Student</span
                        >
                    </div>
                </div>

                <div class="timeline-item">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <h3>Web Frontend Developer</h3>
                        <p class="timeline-company-name">
                            <a
                                href="https://www.facebook.com/pg/sellaround/about/"
                                >Sellaround GmbH</a
                            >
                        </p>
                        <span class="timeline-period"
                            >Jan 2012 - Nov 2013 · Working Student</span
                        >
                    </div>
                </div>
            </div>
        </section>

        <section class="about-section">
            <h2 class="section-title">
                <span class="section-icon">🔗</span>
                Connect
            </h2>
            <div class="connect-grid">
                {
                    connectLinks.map((link) => (
                        <a
                            href={link.href}
                            target={link.href.startsWith("mailto:") ? undefined : "_blank"}
                            rel={link.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                            class="connect-card"
                        >
                            <SocialIcon name={link.name} class="connect-icon" />
                            <span>{link.name}</span>
                        </a>
                    ))
                }
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .about-hero {
        position: relative;
        padding: 0 0 2.5rem;
    }

    .about-image-container {
        display: inline-block;
        margin-bottom: 1.25rem;
        margin-left: -0.5rem;
    }

    .about-image {
        width: 112px;
        height: 112px;
        object-fit: contain;
    }

    .about-title {
        font-size: clamp(2.5rem, 6vw, 3.25rem);
        font-weight: 750;
        letter-spacing: -0.035em;
        line-height: 1.05;
        margin-bottom: 0.75rem;
    }

    .about-tagline {
        color: var(--color-muted);
        font-size: 1.125rem;
    }

    .about-content {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    .about-section {
        padding: 1.5rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card);
    }

    .about-intro {
        padding: 0;
        background: none;
        border: none;
        border-radius: 0;
        font-size: 1.125rem;
    }

    .intro-text {
        font-size: 1.375rem;
        font-weight: 600;
        letter-spacing: -0.015em;
        margin-bottom: 1rem;
    }

    .about-section p {
        color: var(--color-foreground);
        line-height: 1.7;
        margin-bottom: 1rem;
    }

    .about-section p:last-child {
        margin-bottom: 0;
    }

    .about-section a {
        color: var(--color-accent);
        text-decoration: underline;
        text-decoration-thickness: 1.5px;
        text-underline-offset: 0.2em;
        text-decoration-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
        transition: text-decoration-color 0.15s ease;
    }

    .about-section a:hover {
        text-decoration-color: currentColor;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        color: var(--color-foreground);
    }

    .section-icon {
        font-size: 1.5rem;
    }

    /* Timeline */
    .timeline {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .timeline-company {
        background: var(--color-background);
        border-radius: 0.75rem;
        padding: 1.25rem;
    }

    .company-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .company-logo {
        width: 40px;
        height: 40px;
        border-radius: 0.5rem;
    }

    .company-header h3 {
        font-weight: 600;
        color: var(--color-foreground);
    }

    .company-header h3 a {
        background: none !important;
        padding: 0 !important;
    }

    .company-period {
        font-size: 0.875rem;
        color: var(--color-muted);
    }

    .timeline-roles {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding-left: 1rem;
        border-left: 2px solid var(--color-border);
    }

    .role {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        position: relative;
    }

    .role-dot {
        width: 10px;
        height: 10px;
        background: var(--color-border);
        border-radius: 50%;
        flex-shrink: 0;
        margin-left: -1.35rem;
        margin-top: 0.25rem;
    }

    .role.current .role-dot {
        background: var(--color-green);
        box-shadow: 0 0 10px var(--color-green);
    }

    .role-content {
        display: flex;
        flex-direction: column;
    }

    .role-title {
        font-weight: 500;
        color: var(--color-foreground);
    }

    .role-period {
        font-size: 0.75rem;
        color: var(--color-muted);
    }

    .timeline-item {
        display: flex;
        gap: 1rem;
        padding-left: 1rem;
    }

    .timeline-dot {
        width: 10px;
        height: 10px;
        background: var(--color-border);
        border-radius: 50%;
        flex-shrink: 0;
        margin-top: 0.35rem;
    }

    .timeline-content h3 {
        font-weight: 500;
        color: var(--color-foreground);
        margin-bottom: 0.25rem;
    }

    .timeline-company-name {
        font-size: 0.875rem;
        color: var(--color-muted);
        margin-bottom: 0.25rem;
    }

    .timeline-company-name a {
        background: none !important;
        padding: 0 !important;
    }

    .timeline-period {
        font-size: 0.75rem;
        color: var(--color-muted);
    }

    /* Connect Grid */
    .connect-grid {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .connect-card {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1rem;
        background: var(--color-background);
        border-radius: 9999px;
        color: var(--color-muted);
        transition: all 0.2s ease;
        font-size: 0.875rem;
    }

    .connect-card:hover {
        color: var(--color-accent);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px
            color-mix(in srgb, var(--color-accent) 15%, transparent);
    }

    .connect-card :global(.connect-icon) {
        width: 18px;
        height: 18px;
    }

    .connect-card span {
        font-weight: 500;
    }

    /* Skills */
    .skills-cloud {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .skill-tag {
        padding: 0.375rem 0.75rem;
        background: var(--color-background);
        border: 1px solid var(--color-border);
        border-radius: 9999px;
        font-size: 0.875rem;
        color: var(--color-muted);
        transition: all 0.2s ease;
    }

    .skill-tag:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
    }

    .skill-tag.highlight {
        background: color-mix(in srgb, var(--color-accent) 15%, transparent);
        border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
        color: var(--color-accent);
    }

    /* Languages */
    .languages-list {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .language-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .language-flag {
        font-size: 1.5rem;
    }

    .language-name {
        font-weight: 500;
        color: var(--color-foreground);
    }

    .language-level {
        font-size: 0.875rem;
        color: var(--color-muted);
    }
</style>
