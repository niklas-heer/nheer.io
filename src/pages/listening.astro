---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import BackToTop from "../components/BackToTop.astro";
import {
    fetchPodcastData,
    formatDuration,
    formatListeningTime,
    POCKETCASTS_START_DATE,
} from "../utils/database";

import { snapshotStatus } from '../utils/podcast-health.mjs';
const data = await fetchPodcastData();
const freshness = snapshotStatus(data?.stats?.date);
const fixture = (process.env.SITE_TEST_DATA ?? import.meta.env.SITE_TEST_DATA) === 'true';
const snapshotDate = data?.stats?.date ? new Date(data.stats.date).toISOString().slice(0, 10) : null;
const stats = data?.stats;
const podcasts = data?.podcasts || [];
const podcastsByCategory = data?.podcastsByCategory || new Map();
const recentEpisodes = data?.recentEpisodes || [];
const inProgressEpisodes = data?.inProgressEpisodes || [];
const totalEpisodes = data?.totalEpisodes || 0;
const totalCompletedEpisodes = data?.totalCompletedEpisodes || 0;
const daysSinceStart = data?.daysSinceStart || 1;
const yesterdayStats = data?.yesterdayStats;
const monthlyStats = data?.monthlyStats || [];

// Calculate derived stats
const listeningTime = stats ? formatListeningTime(stats.timeListened) : null;
const timeSaved = stats
    ? formatListeningTime(
          stats.timeSilenceRemoval +
              stats.timeSkipping +
              stats.timeIntroSkipping +
              stats.timeVariableSpeed,
      )
    : null;

// Calculate averages
const totalHours = stats ? Math.round(stats.timeListened / 3600) : 0;
const avgMinutesPerDay = stats
    ? Math.round(stats.timeListened / 60 / daysSinceStart)
    : 0;
const avgHoursPerWeek = stats
    ? Math.round((stats.timeListened / 3600 / daysSinceStart) * 7 * 10) / 10
    : 0;

// Generate chart data for the current month
const now = new Date();
const daysInMonth = new Date(
    now.getFullYear(),
    now.getMonth() + 1,
    0,
).getDate();
const monthName = now.toLocaleDateString("en-US", { month: "long" });

// Helper to normalize date to YYYY-MM-DD string
function toDateString(date: string | Date): string {
    if (date instanceof Date) {
        return date.toISOString().split("T")[0];
    }
    return String(date).split("T")[0];
}

// Create array with all days of the month, filling in zeros for missing days
const chartData = Array.from({ length: daysInMonth }, (_, i) => {
    const day = i + 1;
    const dateStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
    const dayStats = monthlyStats.find((s) => toDateString(s.date) === dateStr);
    return {
        day,
        minutes: dayStats ? Math.round(dayStats.timeListened / 60) : 0,
        episodes: dayStats ? dayStats.episodesCompleted : 0,
    };
});

// Find max value for scaling the chart
const maxMinutes = Math.max(...chartData.map((d) => d.minutes), 60); // minimum 60 for scale

// Sort categories by total episodes listened (sum of all podcasts in category)
const sortedCategories = Array.from(podcastsByCategory.entries())
    .map(([category, categoryPodcasts]) => {
        const totalEpisodesInCategory = categoryPodcasts.reduce(
            (sum, p) => sum + (p.episodeCount || 0),
            0,
        );
        return {
            category,
            podcasts: categoryPodcasts,
            totalEpisodes: totalEpisodesInCategory,
        };
    })
    .sort((a, b) => b.totalEpisodes - a.totalEpisodes);

// Helper to format publish date
function formatPublishDate(dateStr: string | null): string {
    if (!dateStr) return "";
    const date = new Date(dateStr);
    return date.toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
    });
}

// Helper to build episode URL
// Format: https://pocketcasts.com/podcast/{podcast_slug}/{podcast_uuid}/{episode_slug}/{episode_uuid}
function buildEpisodeUrl(episode: {
    podcastSlug?: string | null;
    podcastUuid: string;
    slug: string | null;
    uuid: string;
}): string {
    if (episode.podcastSlug && episode.slug) {
        return `https://pocketcasts.com/podcast/${episode.podcastSlug}/${episode.podcastUuid}/${episode.slug}/${episode.uuid}`;
    }
    // Fallback to podcast page if slugs are missing
    return `https://pocketcasts.com/podcast/${episode.podcastSlug || episode.podcastUuid}`;
}

// Helper to build podcast URL
function buildPodcastUrl(podcast: {
    slug: string | null;
    uuid: string;
}): string {
    if (podcast.slug) {
        return `https://pocketcasts.com/podcast/${podcast.slug}/${podcast.uuid}`;
    }
    return `https://pocketcasts.com/podcast/${podcast.uuid}`;
}

// Category icons
const categoryIcons: Record<string, string> = {
    Technology: "💻",
    "News & Politics": "📰",
    Business: "💼",
    "Society & Culture": "🌍",
    "Personal Development": "🎯",
    "True Crime": "🔍",
    Education: "📚",
    "Health & Fitness": "💪",
    Science: "🔬",
    History: "📜",
    Arts: "🎨",
    Comedy: "😄",
    Music: "🎵",
    Gaming: "🎮",
    Sports: "⚽",
    Uncategorized: "📻",
};

// Axis ticks for the month chart: the top of the scale and its half.
const yTicks = [maxMinutes, Math.round(maxMinutes / 2), 0];
const today = now.getDate();
const todayMinutes = chartData[today - 1]?.minutes ?? 0;
---

<BaseLayout
    title="Listening"
    description="My podcast listening stats and subscriptions"
>
    <div class="page-header">
        <h1 class="page-title" style="view-transition-name: page-title;">
            Listening
        </h1>
        <p class="page-subtitle">
            What I listen to and how much, tracked with <a
                href="https://pocketcasts.com"
                target="_blank"
                rel="noopener">Pocket Casts</a
            >.
        </p>
    </div>

    {
        !data && (
            <div class="text-muted italic">
                Podcast data unavailable. Check back later!
            </div>
        )
    }

    {snapshotDate && (
        <p class="text-muted mb-8" data-podcast-freshness={freshness}>
            {fixture ? 'Preview: sample data for automated tests. ' : ''}
            Last data update: <time datetime={snapshotDate}>{snapshotDate}</time>.
            {freshness !== 'fresh' && ' Updates are paused; the figures below show the last recorded snapshot.'}
        </p>
    )}
    {/* Stats Section */}
    {
        data && stats && (
            <section class="mb-12">
                {/* Main Stats */}
                <div class="stats-grid-main">
                    {/* Total Listening Time - Hero Stat */}
                    <div class="stat-card stat-hero">
                        <span class="stat-hero-number">
                            {totalHours.toLocaleString()}
                        </span>
                        <span class="stat-hero-unit">hours</span>
                        <span class="stat-hero-label">
                            total listening time
                        </span>
                        <span class="stat-hero-subtitle">
                            since Aug 2, 2015
                        </span>
                    </div>

                    {/* Yesterday's Listening */}
                    <div class="stat-card stat-yesterday">
                        {yesterdayStats ? (
                            <>
                                <span class="stat-yesterday-number">
                                    {Math.round(
                                        yesterdayStats.timeListened / 60,
                                    )}
                                </span>
                                <span class="stat-yesterday-unit">min</span>
                                <span class="stat-yesterday-label">
                                    yesterday
                                </span>
                                {yesterdayStats.episodesCompleted > 0 && (
                                    <span class="stat-yesterday-episodes">
                                        {yesterdayStats.episodesCompleted}{" "}
                                        {yesterdayStats.episodesCompleted === 1
                                            ? "episode"
                                            : "episodes"}{" "}
                                        finished
                                    </span>
                                )}
                            </>
                        ) : (
                            <>
                                <span class="stat-yesterday-number">--</span>
                                <span class="stat-yesterday-unit">min</span>
                                <span class="stat-yesterday-label">
                                    yesterday
                                </span>
                                <span class="stat-yesterday-episodes collecting">
                                    Collecting data...
                                </span>
                            </>
                        )}
                    </div>

                    {/* Daily Average */}
                    <div class="stat-card stat-average">
                        <span class="stat-avg-number">{avgMinutesPerDay}</span>
                        <span class="stat-avg-unit">min/day</span>
                        <span class="stat-avg-label">average</span>
                        <span class="stat-avg-weekly">
                            ~{avgHoursPerWeek}h per week
                        </span>
                    </div>

                    {/* Time Saved */}
                    <div class="stat-card stat-saved">
                        <span class="stat-saved-number">{timeSaved?.days}</span>
                        <span class="stat-saved-unit">days</span>
                        <span class="stat-saved-label">time saved</span>
                    </div>
                </div>

                {/* Secondary Stats */}
                <div class="stats-grid-secondary">
                    <div class="stat-mini">
                        <span class="stat-mini-value">{podcasts.length}</span>
                        <span class="stat-mini-label">subscriptions</span>
                    </div>
                    <div class="stat-mini">
                        <span class="stat-mini-value">
                            {totalCompletedEpisodes}
                        </span>
                        <span class="stat-mini-label">completed</span>
                    </div>
                    <div class="stat-mini">
                        <span class="stat-mini-value">{totalEpisodes}</span>
                        <span class="stat-mini-label">tracked</span>
                    </div>
                    <div class="stat-mini">
                        <span class="stat-mini-value">
                            {daysSinceStart.toLocaleString()}
                        </span>
                        <span class="stat-mini-label">days listening</span>
                    </div>
                </div>

                {/* Monthly Chart */}
                <figure class="monthly-chart">
                    <figcaption class="chart-head">
                        <h3 class="chart-title">Listening in {monthName}</h3>
                        <p class="chart-legend">
                            <span class="chart-swatch" aria-hidden="true" />
                            today · minutes per day
                        </p>
                    </figcaption>
                    <div class="chart-plot">
                        <div class="chart-y-axis" aria-hidden="true">
                            {yTicks.map((tick) => (
                                <span class="chart-y-label">{tick}</span>
                            ))}
                        </div>
                        <div
                            class="chart-bars"
                            role="img"
                            aria-label={`Minutes listened on each day of ${monthName}. Today so far: ${todayMinutes} minutes. The scale runs to ${maxMinutes} minutes.`}
                        >
                            {chartData.map(({ day, minutes }) => {
                                const height = (minutes / maxMinutes) * 100;
                                return (
                                    <div
                                        class:list={["chart-bar-wrapper", { today: day === today, future: day > today }]}
                                        title={day > today ? undefined : `${monthName} ${day}: ${minutes} min`}
                                    >
                                        {minutes > 0 && <div class="chart-bar" style={`height: ${height}%`} />}
                                    </div>
                                );
                            })}
                        </div>
                        <div class="chart-x-axis" aria-hidden="true">
                            {chartData.map(({ day }) => (
                                <span class:list={["chart-day-label", { today: day === today }]}>
                                    {/* Today is always labelled; a regular tick too close to it gives way. */}
                                    {(day === today || (day % 5 === 1 && Math.abs(day - today) > 2)) && day}
                                </span>
                            ))}
                        </div>
                        {monthlyStats.length > 0 && (
                            <table class="sr-only">
                                <caption>Minutes listened per day in {monthName}</caption>
                                <thead><tr><th scope="col">Day</th><th scope="col">Minutes</th></tr></thead>
                                <tbody>
                                    {chartData.filter(({ day }) => day <= today).map(({ day, minutes }) => (
                                        <tr><th scope="row">{monthName} {day}</th><td>{minutes}</td></tr>
                                    ))}
                                </tbody>
                            </table>
                        )}
                        {monthlyStats.length === 0 && (
                            <div class="chart-empty">
                                <span>
                                    Chart will populate as data is collected
                                </span>
                            </div>
                        )}
                    </div>
                </figure>

                {/* Time Saved Breakdown */}
                <div class="time-saved-breakdown">
                    <h3 class="chart-title">Time Saved Breakdown</h3>
                    <div class="breakdown-grid">
                        <div class="breakdown-item">
                            <span class="breakdown-label">Silence Removal</span>
                            <span class="breakdown-value">
                                {
                                    formatListeningTime(
                                        stats.timeSilenceRemoval,
                                    ).total
                                }
                            </span>
                        </div>
                        <div class="breakdown-item">
                            <span class="breakdown-label">Variable Speed</span>
                            <span class="breakdown-value">
                                {
                                    formatListeningTime(stats.timeVariableSpeed)
                                        .total
                                }
                            </span>
                        </div>
                        <div class="breakdown-item">
                            <span class="breakdown-label">Skipping</span>
                            <span class="breakdown-value">
                                {formatListeningTime(stats.timeSkipping).total}
                            </span>
                        </div>
                        <div class="breakdown-item">
                            <span class="breakdown-label">Intro Skipping</span>
                            <span class="breakdown-value">
                                {
                                    formatListeningTime(stats.timeIntroSkipping)
                                        .total
                                }
                            </span>
                        </div>
                    </div>
                </div>
            </section>
        )
    }

    {/* Currently Listening */}
    {
        inProgressEpisodes.length > 0 && (
            <section class="mb-12">
                <h2 class="section-heading">
                    <span class="now-dot" aria-hidden="true" />
                    Currently Listening
                </h2>

                <div class="episodes-list">
                    {inProgressEpisodes.map((episode) => {
                        const progress =
                            episode.duration > 0
                                ? Math.round(
                                      (episode.playedUpTo / episode.duration) *
                                          100,
                                  )
                                : 0;
                        return (
                            <a
                                href={buildEpisodeUrl(episode)}
                                target="_blank"
                                rel="noopener"
                                class="episode-card in-progress"
                            >
                                {episode.podcastImageUrl ? (
                                    <Image
                                        src={episode.podcastImageUrl}
                                        alt={
                                            episode.podcastTitle ||
                                            "Podcast cover"
                                        }
                                        width={48}
                                        height={48}
                                        class="episode-image"
                                        loading="lazy"
                                    />
                                ) : (
                                    <div class="episode-image-placeholder">
                                        <span>🎙️</span>
                                    </div>
                                )}
                                <div class="episode-info">
                                    <h3 class="episode-title">
                                        {episode.title}
                                    </h3>
                                    <p class="episode-podcast">
                                        {episode.podcastTitle}
                                        {episode.publishedAt && (
                                            <span class="episode-date">
                                                {" "}
                                                ·{" "}
                                                {formatPublishDate(
                                                    episode.publishedAt,
                                                )}
                                            </span>
                                        )}
                                    </p>
                                    <div class="progress-bar-container">
                                        <div
                                            class="progress-bar"
                                            style={`width: ${progress}%`}
                                        />
                                    </div>
                                                    <p class="episode-progress-text">
                                                        {formatDuration(episode.playedUpTo)} /{" "}
                                                        {formatDuration(episode.duration)} ({progress}%)
                                                    </p>
                                </div>
                            </a>
                        );
                    })}
                </div>
            </section>
        )
    }

    {/* Recent Episodes */}
    {
        recentEpisodes.length > 0 && (
            <section class="mb-12">
                <h2 class="section-heading">Recently Listened</h2>

                <div class="episodes-list">
                    {recentEpisodes.slice(0, 10).map((episode) => (
                        <a
                            href={buildEpisodeUrl(episode)}
                            target="_blank"
                            rel="noopener"
                            class="episode-card"
                        >
                            {episode.podcastImageUrl ? (
                                <Image
                                    src={episode.podcastImageUrl}
                                    alt={
                                        episode.podcastTitle || "Podcast cover"
                                    }
                                    width={48}
                                    height={48}
                                    class="episode-image"
                                    loading="lazy"
                                />
                            ) : (
                                <div class="episode-image-placeholder">
                                    <span>🎙️</span>
                                </div>
                            )}
                            <div class="episode-info">
                                <h3 class="episode-title">{episode.title}</h3>
                                <p class="episode-podcast">
                                    {episode.podcastTitle}
                                    {episode.publishedAt && (
                                        <span class="episode-date">
                                            {" "}
                                            ·{" "}
                                            {formatPublishDate(
                                                episode.publishedAt,
                                            )}
                                        </span>
                                    )}
                                </p>
                            </div>
                            <div class="episode-meta">
                                <span class="episode-duration">
                                    {formatDuration(episode.duration)}
                                </span>
                                {episode.completed && (
                                    <span class="episode-completed">✓</span>
                                )}
                            </div>
                        </a>
                    ))}
                </div>
            </section>
        )
    }

    {/* Podcasts by Category */}
    {
        sortedCategories.length > 0 && (
            <section>
                <h2 class="section-heading">Subscriptions by Category</h2>

                <div class="categories-list">
                    {sortedCategories.map(
                        (
                            {
                                category,
                                podcasts: categoryPodcasts,
                                totalEpisodes: categoryEpisodes,
                            },
                            index,
                        ) => {
                            const icon =
                                categoryIcons[category] ||
                                categoryIcons["Uncategorized"];
                            const isFirstCategory = index === 0;
                            return (
                                <details
                                    class="category-group"
                                    open={isFirstCategory}
                                >
                                    <summary class="category-header">
                                        <span class="category-icon">
                                            {icon}
                                        </span>
                                        <span class="category-name">
                                            {category}
                                        </span>
                                        <span class="category-count">
                                            {categoryPodcasts.length} podcasts
                                        </span>
                                        {categoryEpisodes > 0 && (
                                            <span class="category-episodes">
                                                {categoryEpisodes} episodes
                                            </span>
                                        )}
                                        <span class="category-chevron">
                                            <svg
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                            >
                                                <polyline points="6 9 12 15 18 9" />
                                            </svg>
                                        </span>
                                    </summary>

                                    <div class="podcasts-grid">
                                        {categoryPodcasts.map((podcast) => (
                                            <a
                                                href={buildPodcastUrl(podcast)}
                                                target="_blank"
                                                rel="noopener"
                                                class="podcast-card"
                                            >
                                                {podcast.imageUrl ? (
                                                    <Image
                                                        src={podcast.imageUrl}
                                                        alt={podcast.title}
                                                        width={48}
                                                        height={48}
                                                        class="podcast-image"
                                                        loading="lazy"
                                                    />
                                                ) : (
                                                    <div class="podcast-image-placeholder">
                                                        <span>
                                                            {icon}
                                                        </span>
                                                    </div>
                                                )}
                                                <div class="podcast-info">
                                                    <h3 class="podcast-title">
                                                        {podcast.title}
                                                    </h3>
                                                    {podcast.author && (
                                                        <p class="podcast-author">
                                                            {podcast.author}
                                                        </p>
                                                    )}
                                                    {podcast.episodeCount >
                                                        0 && (
                                                        <p class="podcast-episodes">
                                                            {
                                                                podcast.episodeCount
                                                            }{" "}
                                                            {podcast.episodeCount ===
                                                            1
                                                                ? "episode"
                                                                : "episodes"}{" "}
                                                            listened
                                                        </p>
                                                    )}
                                                </div>
                                            </a>
                                        ))}
                                    </div>
                                </details>
                            );
                        },
                    )}
                </div>
            </section>
        )
    }
</BaseLayout>

<style>
    /* Section headings on this page sit level with their marker. */
    .section-heading {
        align-items: center;
        gap: 0.625rem;
    }

    /* The amber mark: this is happening now. */
    .now-dot {
        width: 0.625rem;
        height: 0.625rem;
        border-radius: 50%;
        background: var(--color-mark);
        animation: now-pulse 2s ease-in-out infinite;
    }

    @keyframes now-pulse {
        50% {
            opacity: 0.4;
        }
    }

    /* Main Stats Grid */
    .stats-grid-main {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }

    @media (min-width: 640px) {
        .stats-grid-main {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    .stat-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card);
        padding: 1.25rem 0.75rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    /* Figures: one flat ink, the headline figure in the accent. */
    .stat-hero-number,
    .stat-yesterday-number,
    .stat-avg-number,
    .stat-saved-number {
        font-size: var(--text-title);
        font-weight: 750;
        letter-spacing: -0.03em;
        line-height: 1;
        color: var(--color-foreground);
    }

    .stat-hero-number {
        font-size: var(--text-display);
        font-weight: 800;
        color: var(--color-accent);
    }

    /* Units, labels and footnotes share the mono label. */
    .stat-hero-unit,
    .stat-yesterday-unit,
    .stat-avg-unit,
    .stat-saved-unit,
    .stat-hero-label,
    .stat-yesterday-label,
    .stat-avg-label,
    .stat-saved-label,
    .stat-mini-label {
        font-family: var(--font-mono);
        font-size: var(--text-label);
        font-weight: 500;
        letter-spacing: 0.04em;
        line-height: 1.4;
        text-transform: uppercase;
        color: var(--color-muted);
    }

    .stat-hero-unit,
    .stat-yesterday-unit,
    .stat-avg-unit,
    .stat-saved-unit {
        margin-top: 0.25rem;
        color: var(--color-foreground);
    }

    .stat-hero-subtitle,
    .stat-yesterday-episodes,
    .stat-avg-weekly {
        margin-top: 0.125rem;
        font-size: var(--text-label);
        line-height: 1.4;
        color: var(--color-muted);
    }

    .stat-yesterday-episodes.collecting {
        font-style: italic;
    }

    /* Secondary Stats Grid */
    .stats-grid-secondary {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.5rem;
        margin-top: 1rem;
    }

    @media (min-width: 640px) {
        .stats-grid-secondary {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    .stat-mini {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-chip);
        padding: 0.75rem 0.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .stat-mini-value {
        font-size: var(--text-lead);
        font-weight: 700;
        color: var(--color-foreground);
        line-height: 1;
    }

    .stat-mini-label {
        margin-top: 0.375rem;
    }

    /*
     * Monthly chart. Flat violet bars, today in the amber mark. The plot is a
     * grid: axis labels sit on their gridlines, day labels in a row below.
     */
    .monthly-chart {
        margin-top: 1.5rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-card);
        padding: 1.25rem 1.5rem 1.5rem;
    }

    .chart-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.25rem 1rem;
        margin-bottom: 1.25rem;
    }

