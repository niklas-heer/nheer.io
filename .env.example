# Hardcover API - Get your token from https://hardcover.app/account/api
HARDCOVER_API_TOKEN=your_token_here

# Pocket Casts - Your login credentials (requires Pocket Casts Plus for web player access)
POCKETCASTS_EMAIL=your_email_here
POCKETCASTS_PASSWORD=your_password_here

# PostgreSQL - Use the private homelab service from cluster jobs
DATABASE_URL=postgres://user:password@host/database?sslmode=verify-full

# OpenRouter API - Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here

# GitHub API - Create a fine-grained PAT at https://github.com/settings/tokens?type=beta
# Only needs: Public repositories (read-only)
GITHUB_TOKEN=github_pat_your_token_here

# Homelab publishing - keep these in the 1Password homelab vault
NETLIFY_SITE_ID=your_existing_netlify_site_id
NETLIFY_AUTH_TOKEN=your_netlify_deployment_token

# Vercel is the publishing target. Use netlify explicitly only for rollback.
SITE_DEPLOY_TARGET=vercel
PUBLIC_PAGE_VIEWS_ENABLED=true
VERCEL_PROJECT_ID=prj_your_site
VERCEL_ORG_ID=team_your_team
VERCEL_TOKEN=your_deployment_token
# The sync and publish stages use VERCEL_TOKEN; no runtime secrets on Vercel.
# Optional: stage production without assigning domains during migration.
VERCEL_SKIP_DOMAIN=false
